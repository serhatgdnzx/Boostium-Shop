                                    <span id="discord-server-members" class="text-gray-300 text-sm font-medium whitespace-nowrap block">0 members</span>
                                    <span id="discord-server-online" class="text-gray-500 text-xs whitespace-nowrap block">0 online</span>
                                </div>
                                <div class="w-8 h-8 rounded-full bg-gradient-to-br from-green-500 to-green-600 flex items-center justify-center shadow-lg border-2 border-green-400/30">
                                    <i class="fas fa-check text-white text-xs"></i>
                                </div>
