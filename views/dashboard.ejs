                    >
                        <i class="fas fa-shopping-cart"></i>
                        Purchase Selected Boost
                    </button>

                    <!-- Bulk Order -->
                    <div class="bg-green-500/20 border border-green-500/30 rounded-xl p-4 flex items-center justify-between">
                        <div class="flex items-center gap-3">
                            <i class="fas fa-shopping-cart text-green-400"></i>
                            <div>
                                <p class="font-semibold text-green-300">Bulk Order Boost Keys</p>
                                <p class="text-xs text-gray-400">Order multiple boost keys with bulk discounts</p>
                            </div>
                        </div>
                        <button onclick="showBulkOrderSoon()" class="px-6 py-2 bg-green-600 hover:bg-green-500 rounded-lg font-semibold transition-colors">
                            Bulk Order
                        </button>
                    </div>
                </div>

                <!-- Customer Reviews Section -->
                <div class="spotlight-card rounded-2xl p-6">
                    <div class="flex items-center gap-2 mb-6">
                        <i class="fas fa-star text-yellow-400"></i>
                        <h2 class="text-xl font-bold">Customer Reviews</h2>
                    </div>

                    <div class="relative">
                        <!-- Review Card Container -->
                        <div id="review-container">
                            <div class="spotlight-card rounded-xl p-6 bg-white/5 border border-white/10">
                                <div class="text-center text-gray-400 py-8">
                                    <i class="fas fa-spinner fa-spin text-3xl mb-2 opacity-50"></i>
                                    <p>Loading reviews...</p>
                                </div>
                            </div>
                        </div>

                        <!-- Navigation Arrows -->
                        <button id="review-prev" onclick="changeReview(-1)" class="absolute left-0 top-1/2 -translate-y-1/2 -translate-x-4 w-8 h-8 rounded-full bg-white/10 border border-white/20 flex items-center justify-center hover:bg-white/20 transition-colors hidden">
                            <i class="fas fa-chevron-left text-xs"></i>
                        </button>
                        <button id="review-next" onclick="changeReview(1)" class="absolute right-0 top-1/2 -translate-y-1/2 translate-x-4 w-8 h-8 rounded-full bg-white/10 border border-white/20 flex items-center justify-center hover:bg-white/20 transition-colors hidden">
                            <i class="fas fa-chevron-right text-xs"></i>
                        </button>

                        <!-- Pagination Dots -->
                        <div class="flex justify-center gap-2 mt-4" id="review-dots"></div>
                    </div>

                    <button class="mt-6 w-full px-6 py-3 bg-gradient-to-r from-purple-600 to-pink-600 hover:from-purple-500 hover:to-pink-500 rounded-xl font-semibold flex items-center justify-center gap-2 transition-all">
                        <i class="fas fa-star"></i>
                        Leave us a review
                    </button>
                </div>
            </div>

            <!-- Right Column (1/3) -->
            <div class="space-y-6">
                <!-- Credits Leaderboard -->
                <div class="spotlight-card rounded-2xl p-6">
                    <div class="flex items-center justify-between mb-6">
                        <div class="flex items-center gap-2">
                            <i class="fas fa-trophy text-yellow-400"></i>
                            <h2 class="text-xl font-bold">Credits Leaderboard</h2>
                        </div>
                        
                    </div>

                    <!-- Table Headers -->
                    <div class="grid grid-cols-[40px_1fr_120px_120px] gap-4 mb-3 px-2 text-xs font-semibold text-gray-400 uppercase tracking-wider">
                        <div>#</div>
                        <div>User</div>
                      
                        <div class="text-right">Total Credits</div>
                    </div>

                    <!-- Leaderboard Rows -->
                    <div class="space-y-2 max-h-[600px] overflow-y-auto">
                        <% if (typeof leaderboard !== 'undefined' && leaderboard && leaderboard.length > 0) { %>
                            <% leaderboard.forEach((user, index) => { %>
                                <% 
                                    const rank = index + 1;
                                    let rankBadgeClass = 'rank-other';
                                    if (rank === 1) rankBadgeClass = 'rank-1';
                                    else if (rank === 2) rankBadgeClass = 'rank-2';
                                    else if (rank === 3) rankBadgeClass = 'rank-3';

                                    let avatarInitials = 'U';
                                    if (user.name && user.name.trim().length > 0) {
                                        const nameParts = user.name.trim().split(' ');
                                        avatarInitials = (nameParts[0][0] || '').toUpperCase();
                                    } else if (user.email) {
                                        avatarInitials = user.email[0].toUpperCase();
                                    }

                                    let rankBadgeText = 'Prestige';
                                    let rankBadgeIcon = 'fa-crown';
                                    let rankBadgeClassCSS = 'rank-badge-prestige';
                                    
                                    if (rank === 4 || rank === 10) {
                                        rankBadgeText = 'Gold';
                                        rankBadgeIcon = 'fa-medal';
                                        rankBadgeClassCSS = 'rank-badge-gold';
                                    } else if (user.Rank && user.Rank !== 'No Rank' && user.Rank.toLowerCase().includes('gold')) {
                                        rankBadgeText = 'Gold';
                                        rankBadgeIcon = 'fa-medal';
                                        rankBadgeClassCSS = 'rank-badge-gold';
                                    }
                                %>
                                <div class="leaderboard-row grid grid-cols-[40px_1fr_120px_120px] gap-4 items-center py-3 px-2 rounded-lg">
                                    <!-- Rank Number -->
                                    <div class="flex justify-left">
                                        <div class="leaderboard-rank-badge <%= rankBadgeClass %>">
                                            <%= rank %>
                                        </div>
                                    </div>
                                    <!-- User Info -->
                                    <div class="flex items-center gap-3 min-w-0">
                                        <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-purple-500 to-pink-500 flex items-center justify-center text-xs font-bold flex-shrink-0">
                                            <%= avatarInitials %>
                                        </div>
                                        <span class="text-sm font-semibold text-gray-100 truncate">
                                            <%= user.name || user.email || 'Unknown' %>
                                        </span>
                                    </div>
                                    <!-- Rank Badge -->
                                    
                                    <!-- Total Credits -->
                                    <div class="text-right">
                                        <span class="text-sm font-bold text-white">
                                            $<%= (user.TotalSpent || 0).toFixed(2) %>
                                        </span>
                                    </div>
                                </div>
                            <% }); %>
                        <% } else { %>
                            <div class="text-center py-8 text-gray-400">
                                <p>No users on leaderboard yet</p>
                            </div>
                        <% } %>
                    </div>
                </div>

                <!-- Your Rank -->
                <div class="spotlight-card rounded-2xl p-6">
                    <div class="flex items-center gap-2 mb-4">
                        <i class="fas fa-trophy text-purple-400"></i>
                        <h2 class="text-xl font-bold">Your Rank</h2>
                    </div>
                    <%
                        let rankName = (typeof userStats !== 'undefined' && userStats && userStats.Rank) ? userStats.Rank : 'Bronze';
                        let rankXP = (typeof userStats !== 'undefined' && userStats && userStats.RankXP) ? userStats.RankXP : 0;
                        let rankNextXP = (typeof userStats !== 'undefined' && userStats && userStats.RankNextXP) ? userStats.RankNextXP : 500;
                        let neededXP = Math.max(0, rankNextXP - rankXP);
                        let progressPercent = 0;
                        let rankIcon = 'fa-medal';
                        let rankColor = 'from-amber-600 to-orange-600';
                        let rankDiscount = 0;
                        
                        const rankConfig = {
                            'Bronze': { icon: 'fa-medal', color: 'from-amber-600 to-orange-600', discount: 0, nextXP: 500 },
                            'Silver': { icon: 'fa-medal', color: 'from-gray-400 to-gray-500', discount: 2, nextXP: 1500 },
                            'Gold': { icon: 'fa-medal', color: 'from-yellow-400 to-yellow-600', discount: 5, nextXP: 5000 },
                            'Platinum': { icon: 'fa-crown', color: 'from-cyan-400 to-blue-500', discount: 10, nextXP: 15000 },
                            'Diamond': { icon: 'fa-gem', color: 'from-blue-400 to-purple-500', discount: 15, nextXP: 50000 },
                            'Master': { icon: 'fa-crown', color: 'from-purple-500 to-pink-500', discount: 20, nextXP: 100000 },
                            'Legend': { icon: 'fa-crown', color: 'from-red-500 to-orange-500', discount: 25, nextXP: Infinity }
                        };
                        
                        let config = rankConfig[rankName] || rankConfig['Bronze'];
                        rankIcon = config.icon;
                        rankColor = config.color;
                        rankDiscount = config.discount;
                        
                        if (rankNextXP && rankNextXP !== Infinity) {
                            const currentLevelMin = rankName === 'Bronze' ? 0 : 
                                                    rankName === 'Silver' ? 500 :
                                                    rankName === 'Gold' ? 1500 :
                                                    rankName === 'Platinum' ? 5000 :
                                                    rankName === 'Diamond' ? 15000 :
                                                    rankName === 'Master' ? 50000 : 100000;
                            const range = rankNextXP - currentLevelMin;
                            const progress = rankXP - currentLevelMin;
                            progressPercent = Math.min(100, Math.max(0, (progress / range) * 100));
                        } else {
                            progressPercent = 100;
                        }
                    %>
                    <div class="text-center mb-6">
                        <!-- Rank Icon and Name -->
                        <div class="flex items-center justify-center mb-4">
                            <div class="w-20 h-20 rounded-full bg-gradient-to-br <%= rankColor %> flex items-center justify-center shadow-lg shadow-purple-500/30">
                                <i class="fas <%= rankIcon %> text-white text-3xl"></i>
                            </div>
                        </div>
                        <div class="text-3xl font-bold mb-2 bg-gradient-to-r <%= rankColor %> bg-clip-text text-transparent">
                            <%= rankName %>
                        </div>
                        <div class="text-lg font-semibold text-gray-300 mb-1">
                            <%= rankXP.toLocaleString() %> XP
                        </div>
                        
                        <!-- Progress Bar -->
                        <% if (rankNextXP && rankNextXP !== Infinity) { %>
                            <div class="mt-4 mb-2">
                                <div class="flex justify-between text-xs text-gray-400 mb-1">
                                    <span>Level Progress</span>
                                    <span><%= progressPercent.toFixed(1) %>%</span>
                                </div>
                                <div class="w-full h-3 bg-zinc-800 rounded-full overflow-hidden border border-zinc-700">
                                    <div class="h-full bg-gradient-to-r <%= rankColor %> transition-all duration-500 ease-out" style="width: <%= progressPercent %>%"></div>
                                </div>
                                <div class="flex justify-between text-xs text-gray-500 mt-1">
