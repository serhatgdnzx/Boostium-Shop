    <!-- Spotlight Effect Script -->
    <script>
        const cards = document.querySelectorAll('.spotlight-card');
        
        cards.forEach(card => {
            card.addEventListener('mousemove', (e) => {
                const rect = card.getBoundingClientRect();
                const x = e.clientX - rect.left;
                const y = e.clientY - rect.top;
                card.style.setProperty('--mouse-x', `${x}px`);
                card.style.setProperty('--mouse-y', `${y}px`);
            });
        });

        const API_URL = '<%= apiUrl || "/api" %>';
        let currentDuration = 1;

        async function loadPackages(duration) {
            currentDuration = duration;
            selectedPackageId = null; // Reset selection
            
            document.querySelectorAll('[id^="tab-"]').forEach(btn => {
                btn.classList.remove('bg-indigo-600', 'text-white');
                btn.classList.add('text-gray-400');
            });
            
            if (duration === 1) {
                document.getElementById('tab-1month').classList.add('bg-indigo-600', 'text-white');
                document.getElementById('tab-1month').classList.remove('text-gray-400');
            } else if (duration === 3) {
                document.getElementById('tab-3months').classList.add('bg-indigo-600', 'text-white');
                document.getElementById('tab-3months').classList.remove('text-gray-400');
            }

            const container = document.getElementById('packages-container');
            container.innerHTML = '<div class="col-span-4 text-center text-gray-400 py-8"><i class="fas fa-spinner fa-spin text-2xl mb-2"></i><p>Loading...</p></div>';

            try {
                const response = await fetch(`${API_URL}/boosts/packages/${duration}`);
                const data = await response.json();

                if (data.success && data.packages) {
                    renderPackages(data.packages);
                } else {
                    container.innerHTML = '<div class="col-span-4 text-center text-gray-400 py-8"><p>No packages found</p></div>';
                }
            } catch (error) {
                console.error('Package loading error:', error);
                container.innerHTML = '<div class="col-span-4 text-center text-red-400 py-8"><p>Loading error. Please try again.</p></div>';
            }
        }

        function renderPackages(packages) {
            const container = document.getElementById('packages-container');
            const noBoostsMessage = document.getElementById('no-boosts-message');

            if (packages.length === 0) {
                if (noBoostsMessage) {
                    noBoostsMessage.classList.remove('hidden');
                }
                container.innerHTML = '<div class="col-span-4 text-center text-gray-400 py-8"><p>No boosts available for this duration.</p></div>';
                return;
            } else {
                if (noBoostsMessage) {
                    noBoostsMessage.classList.add('hidden');
                }
            }

            container.innerHTML = packages.map((pkg, index) => `
                <div 
                    class="spotlight-card rounded-xl p-4 relative overflow-hidden package-card ${!pkg.inStock ? 'disabled opacity-50 cursor-not-allowed' : 'cursor-pointer'} ${selectedPackageId === pkg._id ? 'ring-2 ring-purple-500' : ''}"
                    data-package-id="${pkg._id}"
                    onclick="${pkg.inStock ? `selectPackage('${pkg._id}', ${index})` : ''}"
                >
                    ${!pkg.inStock ? `
                        <div class="absolute top-2 left-0 right-0 transform -rotate-12 origin-center z-20">
                            <div class="bg-red-500/90 backdrop-blur-sm px-3 py-1 mx-auto w-fit rounded shadow-lg">
                                <span class="text-white text-xs font-bold">OUT OF STOCK</span>
                            </div>
                        </div>
                    ` : ''}
                    <div class="text-center relative z-10">
                        <div class="text-lg font-bold mb-1">${pkg.quantity} Boosts</div>
                        <div class="text-xl font-bold text-purple-400">$${pkg.price.toFixed(2)}</div>
                        <div class="text-xs text-gray-400">$${pkg.pricePerBoost.toFixed(2)} per boost</div>
                    </div>
                </div>
            `).join('');

            const newCards = container.querySelectorAll('.spotlight-card');
            newCards.forEach(card => {
                card.addEventListener('mousemove', (e) => {
                    const rect = card.getBoundingClientRect();
                    const x = e.clientX - rect.left;
                    const y = e.clientY - rect.top;
                    card.style.setProperty('--mouse-x', `${x}px`);
                    card.style.setProperty('--mouse-y', `${y}px`);
                });
            });
        }

        let selectedPackageId = null;
        let selectedPackageData = null;
        
        function selectPackage(packageId, index) {
            document.querySelectorAll('.package-card').forEach(card => {
                card.classList.remove('ring-2', 'ring-purple-500');
            });
            
            const selectedCard = document.querySelector(`[data-package-id="${packageId}"]`);
            if (selectedCard && !selectedCard.classList.contains('disabled')) {
                selectedCard.classList.add('ring-2', 'ring-purple-500');
                selectedPackageId = packageId;
                
                fetch(`${API_URL}/boosts/packages/${currentDuration}`)
                    .then(res => res.json())
                    .then(data => {
                        if (data.success && data.packages) {
                            selectedPackageData = data.packages.find(p => p._id === packageId);
                            updatePurchaseButton();
                        }
                    })
                    .catch(err => console.error('Package information could not be retrieved:', err));
            }
        }
        
        function updatePurchaseButton() {
            const purchaseBtn = document.getElementById('purchase-boost-btn');
            const discordInput = document.getElementById('discord-invite-link');
            const discordValidationIcon = document.getElementById('discord-validation-icon');
            
            if (purchaseBtn) {
                const hasValidDiscord = discordInput && discordInput.value.trim() && 
                                       discordValidationIcon && !discordValidationIcon.classList.contains('hidden') &&
                                       document.getElementById('discord-validation-icon-i')?.classList.contains('fa-check-circle');
                
                if (selectedPackageId && hasValidDiscord) {
                    purchaseBtn.classList.remove('hidden');
                    purchaseBtn.disabled = false;
                } else {
                    purchaseBtn.classList.add('hidden');
                    purchaseBtn.disabled = true;
                }
            }
        }
        
        async function purchaseBoost() {
            if (!selectedPackageId || !selectedPackageData) {
                Swal.fire({
                    title: 'No Package Selected',
                    html: `
                        <div class="text-left space-y-3 mt-4">
                            <p class="text-center text-yellow-400">Please select a boost package first.</p>
                        </div>
                    `,
                    icon: 'warning',
                    iconColor: '#f59e0b',
                    confirmButtonText: '<i class="fas fa-check mr-2"></i> OK',
                    customClass: {
                        popup: 'swal2-popup-custom',
                        title: 'swal2-title-custom',
                        htmlContainer: 'swal2-html-container-custom',
                        confirmButton: 'swal2-confirm-custom'
                    },
                    didOpen: () => {
                        const popup = document.querySelector('.swal2-popup');
                        if (popup) {
                            popup.addEventListener('mousemove', (e) => {
                                const rect = popup.getBoundingClientRect();
                                const x = e.clientX - rect.left;
                                const y = e.clientY - rect.top;
                                popup.style.setProperty('--swal2-mouse-x', `${x}px`);
                                popup.style.setProperty('--swal2-mouse-y', `${y}px`);
                            });
                        }
                    }
                });
                return;
            }
            
            const discordInvite = document.getElementById('discord-invite-link')?.value?.trim();
            if (!discordInvite) {
                Swal.fire({
                    title: 'Discord Invite Required',
                    html: `
                        <div class="text-left space-y-3 mt-4">
                            <p class="text-center text-red-400">Please enter a valid Discord invite link.</p>
                        </div>
                    `,
                    icon: 'error',
                    iconColor: '#ef4444',
                    confirmButtonText: '<i class="fas fa-times mr-2"></i> OK',
                    customClass: {
                        popup: 'swal2-popup-custom',
                        title: 'swal2-title-custom',
                        htmlContainer: 'swal2-html-container-custom',
                        confirmButton: 'swal2-confirm-custom'
                    },
                    didOpen: () => {
                        const popup = document.querySelector('.swal2-popup');
                        if (popup) {
                            popup.addEventListener('mousemove', (e) => {
                                const rect = popup.getBoundingClientRect();
                                const x = e.clientX - rect.left;
                                const y = e.clientY - rect.top;
                                popup.style.setProperty('--swal2-mouse-x', `${x}px`);
                                popup.style.setProperty('--swal2-mouse-y', `${y}px`);
                            });
                        }
                    }
                });
                return;
            }
            
            const discordValidationIcon = document.getElementById('discord-validation-icon-i');
            if (!discordValidationIcon || !discordValidationIcon.classList.contains('fa-check-circle')) {
                Swal.fire({
                    title: 'Invalid Discord Invite',
                    html: `
                        <div class="text-left space-y-3 mt-4">
                            <p class="text-center text-red-400">Please enter a valid Discord invite link and wait for validation.</p>
                        </div>
                    `,
                    icon: 'error',
                    iconColor: '#ef4444',
                    confirmButtonText: '<i class="fas fa-times mr-2"></i> OK',
                    customClass: {
                        popup: 'swal2-popup-custom',
                        title: 'swal2-title-custom',
                        htmlContainer: 'swal2-html-container-custom',
                        confirmButton: 'swal2-confirm-custom'
                    },
                    didOpen: () => {
                        const popup = document.querySelector('.swal2-popup');
                        if (popup) {
                            popup.addEventListener('mousemove', (e) => {
                                const rect = popup.getBoundingClientRect();
                                const x = e.clientX - rect.left;
                                const y = e.clientY - rect.top;
                                popup.style.setProperty('--swal2-mouse-x', `${x}px`);
                                popup.style.setProperty('--swal2-mouse-y', `${y}px`);
                            });
                        }
                    }
                });
                return;
            }
            
            const result = await Swal.fire({
                title: 'Confirm Purchase',
                html: `
                    <div class="text-left space-y-3 mt-4">
                        <div class="spotlight-card rounded-xl p-4 border border-white/10 bg-white/5">
                            <div class="flex items-center justify-between mb-2">
                                <span class="text-gray-400 text-sm">Package</span>
                                <span class="text-white font-semibold">${selectedPackageData.quantity} Boosts</span>
                            </div>
                            <div class="flex items-center justify-between mb-2">
                                <span class="text-gray-400 text-sm">Duration</span>
                                <span class="text-white font-semibold">${selectedPackageData.duration} month${selectedPackageData.duration > 1 ? 's' : ''}</span>
                            </div>
                            <div class="flex items-center justify-between mb-2">
                                <span class="text-gray-400 text-sm">Price</span>
                                <span class="text-purple-400 font-bold text-lg">$${selectedPackageData.price.toFixed(2)}</span>
                            </div>
                            <div class="flex items-center justify-between">
                                <span class="text-gray-400 text-sm">Discord Server</span>
                                <span class="text-white font-medium text-sm truncate max-w-[200px]" title="${discordInvite}">${discordInvite}</span>
                            </div>
                        </div>
                    </div>
                `,
                icon: 'question',
                iconColor: '#8b5cf6',
                showCancelButton: true,
                confirmButtonText: '<i class="fas fa-shopping-cart mr-2"></i> Purchase',
                cancelButtonText: '<i class="fas fa-times mr-2"></i> Cancel',
                reverseButtons: true,
                customClass: {
                    popup: 'swal2-popup-custom',
                    title: 'swal2-title-custom',
                    htmlContainer: 'swal2-html-container-custom',
                    confirmButton: 'swal2-confirm-custom',
                    cancelButton: 'swal2-cancel-custom'
                },
                didOpen: () => {
                    const popup = document.querySelector('.swal2-popup');
                    if (popup) {
                        popup.addEventListener('mousemove', (e) => {
                            const rect = popup.getBoundingClientRect();
                            const x = e.clientX - rect.left;
                            const y = e.clientY - rect.top;
                            popup.style.setProperty('--swal2-mouse-x', `${x}px`);
                            popup.style.setProperty('--swal2-mouse-y', `${y}px`);
                        });
                    }
                }
            });
            
            if (!result.isConfirmed) {
                return;
            }
            
            try {
                const token = localStorage.getItem('token') || document.cookie.split('; ').find(row => row.startsWith('token='))?.split('=')[1];
                
                Swal.fire({
                    title: 'Processing...',
                    text: 'Please wait while we process your purchase.',
                    icon: 'info',
                    iconColor: '#8b5cf6',
                    allowOutsideClick: false,
                    allowEscapeKey: false,
                    showConfirmButton: false,
                    customClass: {
                        popup: 'swal2-popup-custom',
                        title: 'swal2-title-custom',
                        htmlContainer: 'swal2-html-container-custom'
                    },
                    didOpen: () => {
                        Swal.showLoading();
                        const popup = document.querySelector('.swal2-popup');
                        if (popup) {
                            popup.addEventListener('mousemove', (e) => {
                                const rect = popup.getBoundingClientRect();
                                const x = e.clientX - rect.left;
                                const y = e.clientY - rect.top;
                                popup.style.setProperty('--swal2-mouse-x', `${x}px`);
                                popup.style.setProperty('--swal2-mouse-y', `${y}px`);
                            });
                        }
                    }
                });
                
                const response = await fetch(`${API_URL}/boosts/purchase`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': `Bearer ${token}`
                    },
                    body: JSON.stringify({
                        packageId: selectedPackageId,
                        discordInvite: discordInvite
                    })
                });
                
                const data = await response.json();
                
                if (data.success) {
                    Swal.fire({
                        title: 'Purchase Successful!',
                        html: `
                            <div class="text-left space-y-3 mt-4">
                                <div class="flex items-center justify-center mb-4">
                                    <div class="w-16 h-16 rounded-full bg-gradient-to-br from-green-500 to-green-600 flex items-center justify-center shadow-lg">
                                        <i class="fas fa-check text-white text-2xl"></i>
                                    </div>
                                </div>
                                <div class="spotlight-card rounded-xl p-4 border border-white/10 bg-white/5 space-y-2">
                                    <p class="text-center text-green-400 font-semibold mb-3">✅ Your boost package has been purchased successfully!</p>
                                    <div class="flex items-center justify-between">
                                        <span class="text-gray-400 text-sm">Package</span>
                                        <span class="text-white font-semibold">${data.data.package.name}</span>
                                    </div>
                                    <div class="flex items-center justify-between">
                                        <span class="text-gray-400 text-sm">Price</span>
                                        <span class="text-purple-400 font-semibold">$${selectedPackageData.price.toFixed(2)}</span>
                                    </div>
                                    <div class="flex items-center justify-between">
                                        <span class="text-gray-400 text-sm">Previous Balance</span>
                                        <span class="text-gray-300 font-semibold">$${data.data.previousBalance.toFixed(2)}</span>
                                    </div>
                                    <div class="flex items-center justify-between pt-2 border-t border-white/10">
                                        <span class="text-gray-400 text-sm font-semibold">New Balance</span>
                                        <span class="text-green-400 font-bold text-lg">$${data.data.newBalance.toFixed(2)}</span>
                                    </div>
                                </div>
                            </div>
                        `,
                        icon: 'success',
                        iconColor: '#10b981',
                        confirmButtonText: '<i class="fas fa-check mr-2"></i> OK',
                        customClass: {
                            popup: 'swal2-popup-custom',
                            title: 'swal2-title-custom',
                            htmlContainer: 'swal2-html-container-custom',
                            confirmButton: 'swal2-confirm-custom'
                        },
                        didOpen: () => {
                            const popup = document.querySelector('.swal2-popup');
                            if (popup) {
                                popup.addEventListener('mousemove', (e) => {
                                    const rect = popup.getBoundingClientRect();
                                    const x = e.clientX - rect.left;
                                    const y = e.clientY - rect.top;
                                    popup.style.setProperty('--swal2-mouse-x', `${x}px`);
                                    popup.style.setProperty('--swal2-mouse-y', `${y}px`);
                                });
                            }
                        }
                    }).then(() => {
                        window.location.reload();
                    });
                } else {
                    Swal.fire({
                        title: 'Purchase Failed',
                        html: `
                            <div class="text-left space-y-3 mt-4">
                                <div class="flex items-center justify-center mb-4">
                                    <div class="w-16 h-16 rounded-full bg-gradient-to-br from-red-500 to-red-600 flex items-center justify-center shadow-lg">
                                        <i class="fas fa-times text-white text-2xl"></i>
                                    </div>
                                </div>
                                <p class="text-center text-red-400">${data.message || 'An error occurred during purchase.'}</p>
                            </div>
                        `,
                        icon: 'error',
                        iconColor: '#ef4444',
                        confirmButtonText: '<i class="fas fa-times mr-2"></i> OK',
                        customClass: {
                            popup: 'swal2-popup-custom',
                            title: 'swal2-title-custom',
                            htmlContainer: 'swal2-html-container-custom',
                            confirmButton: 'swal2-confirm-custom'
                        },
                        didOpen: () => {
                            const popup = document.querySelector('.swal2-popup');
                            if (popup) {
                                popup.addEventListener('mousemove', (e) => {
                                    const rect = popup.getBoundingClientRect();
                                    const x = e.clientX - rect.left;
                                    const y = e.clientY - rect.top;
                                    popup.style.setProperty('--swal2-mouse-x', `${x}px`);
                                    popup.style.setProperty('--swal2-mouse-y', `${y}px`);
                                });
                            }
                        }
                    });
                }
            } catch (error) {
                console.error('Purchase error:', error);
                Swal.fire({
                    title: 'Error',
                    html: `
                        <div class="text-left space-y-3 mt-4">
                            <div class="flex items-center justify-center mb-4">
                                <div class="w-16 h-16 rounded-full bg-gradient-to-br from-red-500 to-red-600 flex items-center justify-center shadow-lg">
                                    <i class="fas fa-exclamation-triangle text-white text-2xl"></i>
                                </div>
                            </div>
                            <p class="text-center text-red-400">An error occurred. Please try again.</p>
                        </div>
                    `,
                    icon: 'error',
                    iconColor: '#ef4444',
                    confirmButtonText: '<i class="fas fa-times mr-2"></i> OK',
                    customClass: {
                        popup: 'swal2-popup-custom',
                        title: 'swal2-title-custom',
                        htmlContainer: 'swal2-html-container-custom',
                        confirmButton: 'swal2-confirm-custom'
                    },
                    didOpen: () => {
                        const popup = document.querySelector('.swal2-popup');
                        if (popup) {
                            popup.addEventListener('mousemove', (e) => {
                                const rect = popup.getBoundingClientRect();
                                const x = e.clientX - rect.left;
                                const y = e.clientY - rect.top;
                                popup.style.setProperty('--swal2-mouse-x', `${x}px`);
                                popup.style.setProperty('--swal2-mouse-y', `${y}px`);
                            });
                        }
                    }
                });
            }
        }

        let discordValidationTimeout = null;

        function clearDiscordValidation() {
            const icon = document.getElementById('discord-validation-icon');
            const message = document.getElementById('discord-validation-message');
            const input = document.getElementById('discord-invite-link');
            const serverCard = document.getElementById('discord-server-card');
            
            if (icon) icon.classList.add('hidden');
            if (message) {
                message.classList.add('hidden');
                message.className = 'mt-2 text-xs hidden';
            }
            if (input) {
                input.classList.remove('border-green-500', 'border-red-500');
                input.classList.add('border-white/10');
            }
            
            if (serverCard) {
                serverCard.classList.add('hidden');
            }

            if (discordValidationTimeout) {
                clearTimeout(discordValidationTimeout);
            }
        }

        async function validateDiscordInvite() {
            const input = document.getElementById('discord-invite-link');
            const icon = document.getElementById('discord-validation-icon');
            const iconI = document.getElementById('discord-validation-icon-i');
            const message = document.getElementById('discord-validation-message');
            
            if (!input || !input.value.trim()) {
                clearDiscordValidation();
                return;
            }

            const inviteUrl = input.value.trim();

            if (discordValidationTimeout) {
                clearTimeout(discordValidationTimeout);
            }

            if (icon) {
                icon.classList.remove('hidden');
                iconI.className = 'fas fa-spinner fa-spin text-gray-400';
            }
            if (input) {
                input.classList.remove('border-green-500', 'border-red-500');
                input.classList.add('border-yellow-500/50');
            }

            discordValidationTimeout = setTimeout(async () => {
                try {
                    const token = localStorage.getItem('token') || document.cookie.split('; ').find(row => row.startsWith('token='))?.split('=')[1];
                    
                    const response = await fetch(`${API_URL}/auth/discord/validate-invite`, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'Authorization': `Bearer ${token}`
                        },
                        body: JSON.stringify({
                            inviteUrl: inviteUrl
                        })
                    });

                    const data = await response.json();

                    if (data.valid) {
                        if (icon) {
                            icon.classList.remove('hidden');
                            iconI.className = 'fas fa-check-circle text-green-400';
                        }
                        if (input) {
                            input.classList.remove('border-yellow-500/50', 'border-red-500');
                            input.classList.add('border-green-500');
                        }
                        if (message) {
                            message.textContent = data.message || 'Discord invite URL is valid';
                            message.className = 'mt-2 text-xs text-green-400';
                            message.classList.remove('hidden');
                        }
                        
                        const serverCard = document.getElementById('discord-server-card');
                        if (serverCard && data.data) {
                            const serverData = data.data;
                            const guild = serverData.guild;
                            const channel = serverData.channel;
                            
                            const serverNameEl = document.getElementById('discord-server-name');
                            if (serverNameEl && guild) {
                                serverNameEl.textContent = guild.name || '[Server]';
                            }
                            
                            const serverIconEl = document.getElementById('discord-server-icon-img');
                            const serverIconTextEl = document.getElementById('discord-server-icon-text');
                            if (guild && guild.icon) {
                                const iconUrl = `https://cdn.discordapp.com/icons/${guild.id}/${guild.icon}.png`;
                                if (serverIconEl) {
                                    serverIconEl.src = iconUrl;
                                    serverIconEl.alt = guild.name || 'Server Icon';
                                    serverIconEl.classList.remove('hidden');
                                }
                                if (serverIconTextEl) {
                                    serverIconTextEl.classList.add('hidden');
                                }
                            } else {
                                if (serverIconTextEl && guild && guild.name) {
                                    serverIconTextEl.textContent = guild.name.charAt(0).toUpperCase();
                                    serverIconTextEl.classList.remove('hidden');
                                }
                                if (serverIconEl) {
                                    serverIconEl.classList.add('hidden');
                                }
                            }
                            
                            const inviteLinkEl = document.getElementById('discord-server-invite');
                            if (inviteLinkEl) {
                                inviteLinkEl.textContent = inviteUrl;
                            }
                            
                            const membersEl = document.getElementById('discord-server-members');
                            const onlineEl = document.getElementById('discord-server-online');
                            if (membersEl && serverData.approximate_member_count) {
                                const memberCount = serverData.approximate_member_count.toLocaleString();
                                membersEl.textContent = `${memberCount} members`;
                            } else if (membersEl) {
                                membersEl.textContent = '0 members';
                            }
                            
                            if (onlineEl && serverData.approximate_presence_count) {
                                const onlineCount = serverData.approximate_presence_count.toLocaleString();
                                onlineEl.textContent = `${onlineCount} online`;
                            } else if (onlineEl) {
                                onlineEl.textContent = '0 online';
                            }
                            
                            serverCard.classList.remove('hidden');
                            
                            serverCard.addEventListener('mousemove', (e) => {
                                const rect = serverCard.getBoundingClientRect();
                                const x = e.clientX - rect.left;
                                const y = e.clientY - rect.top;
                                serverCard.style.setProperty('--mouse-x', `${x}px`);
                                serverCard.style.setProperty('--mouse-y', `${y}px`);
                            });
                        }
                        
                        updatePurchaseButton();
                    } else {
                        if (icon) {
                            icon.classList.remove('hidden');
                            iconI.className = 'fas fa-times-circle text-red-400';
                        }
                        if (input) {
                            input.classList.remove('border-yellow-500/50', 'border-green-500');
                            input.classList.add('border-red-500');
                        }
                        if (message) {
                            message.textContent = data.message || 'Discord invite URL is invalid';
                            message.className = 'mt-2 text-xs text-red-400';
                            message.classList.remove('hidden');
                        }
                        updatePurchaseButton();
                    }
                } catch (error) {
                    console.error('Discord validation error:', error);
                    if (icon) icon.classList.add('hidden');
                    if (input) {
                        input.classList.remove('border-yellow-500/50', 'border-green-500', 'border-red-500');
                        input.classList.add('border-white/10');
                    }
                    if (message) {
                        message.textContent = 'An error occurred during validation';
                        message.className = 'mt-2 text-xs text-yellow-400';
                        message.classList.remove('hidden');
                    }
                }
            }, 500);
        }

        function showBulkOrderSoon() {
            Swal.fire({
                title: 'Coming Soon',
                text: 'Bulk Order feature is under development. Stay tuned 🚀',
                icon: 'info',
                background: '#030014',
                color: '#e5e7eb',
                confirmButtonText: 'OK',
                confirmButtonColor: '#4f46e5',
                customClass: {
                    popup: 'border border-white/10 rounded-2xl shadow-2xl',
                    title: 'text-xl font-bold',
                    confirmButton: 'px-6 py-2 rounded-lg font-semibold'
                }
            });
        }

        const userProfileBtn = document.getElementById('user-profile-btn');
        const userDropdown = document.getElementById('user-dropdown');
        const chevronIcon = document.getElementById('chevron-icon');

        if (userProfileBtn && userDropdown) {
            userProfileBtn.addEventListener('click', (e) => {
                e.stopPropagation();
                userDropdown.classList.toggle('show');
                chevronIcon.style.transform = userDropdown.classList.contains('show') ? 'rotate(180deg)' : 'rotate(0deg)';
            });

            document.addEventListener('click', (e) => {
                if (!userProfileBtn.contains(e.target) && !userDropdown.contains(e.target)) {
                    userDropdown.classList.remove('show');
                    chevronIcon.style.transform = 'rotate(0deg)';
                }
            });
        }

        function copyUserId(event) {
            const userIdElement = document.getElementById('user-id-text');
            const userId = userIdElement ? userIdElement.getAttribute('data-user-id') : null;
            
            if (!userId) {
                console.error('User ID not found');
                return;
            }
            
            navigator.clipboard.writeText(userId).then(() => {
                const btn = event.target;
                const originalIcon = btn.className;
                btn.className = 'fas fa-check copy-id-btn';
                btn.style.color = '#10b981';
                
                setTimeout(() => {
                    btn.className = originalIcon;
                    btn.style.color = '';
                }, 2000);
            }).catch(err => {
                console.error('Failed to copy:', err);
            });
        }

        async function handleLogout() {
            try {
                const response = await fetch(`${API_URL}/auth/logout`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                });

                localStorage.removeItem('token');
                localStorage.removeItem('user');

                document.cookie = 'token=; Max-Age=0; Path=/; SameSite=Lax';

                window.location.href = '/login';
            } catch (error) {
                console.error('Logout error:', error);
                localStorage.removeItem('token');
                localStorage.removeItem('user');
                document.cookie = 'token=; Max-Age=0; Path=/; SameSite=Lax';
                window.location.href = '/login';
            }
        }

        let currentReviewIndex = 0;
        let isAnimating = false;
        const reviews = <%- JSON.stringify((typeof comments !== 'undefined' && comments && Array.isArray(comments)) ? comments : []) %>;

        function formatDate(dateString) {
            const date = new Date(dateString);
            const formattedDate = date.toLocaleDateString('en-US', { month: '2-digit', day: '2-digit', year: 'numeric' });
            const formattedTime = date.toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit', hour12: true });
            return { date: formattedDate, time: formattedTime };
        }

        function getUserInitials(userName, userEmail) {
            if (userName && userName.trim().length > 0) {
                const nameParts = userName.trim().split(' ');
                let initials = (nameParts[0][0] || '').toUpperCase();
                if (nameParts.length > 1 && nameParts[1][0]) {
                    initials += nameParts[1][0].toUpperCase();
                }
                return initials;
            } else if (userEmail) {
                return userEmail[0].toUpperCase();
            }
            return 'U';
        }

        function renderReview(index, animationDirection = null) {
            console.log('renderReview called:', index, animationDirection, 'reviews.length:', reviews ? reviews.length : 0);
            
            if (!reviews || reviews.length === 0) {
                console.log('No reviews available');
                return;
            }
            
            const review = reviews[index];
            if (!review) {
                console.log('Review not found at index:', index);
                return;
            }

            const { date, time } = formatDate(review.CreatedAt);
            const initials = getUserInitials(review.userName, review.userEmail);
            
            let starsHtml = '';
            for (let i = 1; i <= 5; i++) {
                starsHtml += `<i class="fas fa-star ${i <= review.Stars ? 'text-purple-400' : 'text-gray-600'} text-sm"></i>`;
            }

            const reviewContainer = document.getElementById('review-container');
            if (!reviewContainer) {
                console.error('review-container element not found');
                return;
            }
            
            if (animationDirection !== null && reviewContainer.children.length > 0) {
                const currentCard = reviewContainer.querySelector('.review-card');
                if (currentCard) {
                    isAnimating = true;
                    if (animationDirection === 'left') {
                        currentCard.classList.add('slide-out-left');
                    } else if (animationDirection === 'right') {
                        currentCard.classList.add('slide-out-right');
                    } else {
                        currentCard.classList.add('fade-out');
                    }
                    
                    setTimeout(() => {
                        renderNewReview(index, animationDirection);
                    }, 400);
                    return;
                }
            }
            
            renderNewReview(index, animationDirection);
        }

        function renderNewReview(index, animationDirection = null) {
            if (reviews.length === 0) return;
            
            const review = reviews[index];
            if (!review) return;
            
            const { date, time } = formatDate(review.CreatedAt);
            const initials = getUserInitials(review.userName, review.userEmail);
            
            let starsHtml = '';
            for (let i = 1; i <= 5; i++) {
                starsHtml += `<i class="fas fa-star ${i <= review.Stars ? 'text-purple-400' : 'text-gray-600'} text-sm"></i>`;
            }

            const reviewContainer = document.getElementById('review-container');
            
            let entryAnimationClass = '';
            if (animationDirection === 'left') {
                entryAnimationClass = 'slide-in-left';
            } else if (animationDirection === 'right') {
                entryAnimationClass = 'slide-in-right';
            } else if (animationDirection === null) {
                entryAnimationClass = '';
            } else {
                entryAnimationClass = 'fade-in';
            }
            
            reviewContainer.innerHTML = `
                <div class="spotlight-card rounded-xl p-6 bg-white/5 border border-white/10 review-card ${entryAnimationClass}" data-index="${index}">
                    <div class="flex items-start gap-4 mb-4">
                        <div class="w-12 h-12 rounded-full bg-gradient-to-br from-purple-500 to-pink-500 flex items-center justify-center text-white font-bold flex-shrink-0">
                            ${initials}
                        </div>
                        <div class="flex-1">
                            <div class="flex items-center gap-2 mb-2">
                                <span class="font-semibold">@${review.userName || 'User'}</span>
                                <span class="px-2 py-1 bg-purple-500/20 border border-purple-500/30 rounded text-xs font-semibold text-purple-300">Verified</span>
                            </div>
                            <div class="flex gap-1 mb-2">
                                ${starsHtml}
                            </div>
                            <p class="text-gray-300 mb-2">"${review.Comment}"</p>
                            <p class="text-xs text-gray-500">${date}, ${time}</p>
                        </div>
                    </div>
                </div>
            `;
            
            const dotsContainer = document.getElementById('review-dots');
            dotsContainer.innerHTML = '';
            
            if (reviews.length > 1) {
                reviews.forEach((_, i) => {
                    const dot = document.createElement('div');
                    dot.className = `review-dot w-2 h-2 rounded-full ${i === index ? 'bg-purple-500' : 'bg-white/20'} cursor-pointer transition-all duration-300`;
                    dot.onclick = () => goToReview(i);
                    dotsContainer.appendChild(dot);
                });
            }

            const prevBtn = document.getElementById('review-prev');
            const nextBtn = document.getElementById('review-next');
            
            if (reviews.length > 1) {
                if (prevBtn) prevBtn.classList.remove('hidden');
                if (nextBtn) nextBtn.classList.remove('hidden');
            } else {
                if (prevBtn) prevBtn.classList.add('hidden');
                if (nextBtn) nextBtn.classList.add('hidden');
            }
            
            setTimeout(() => {
                isAnimating = false;
            }, 500);
        }

        function changeReview(direction) {
            if (reviews.length === 0 || isAnimating) return;
            
            const previousIndex = currentReviewIndex;
            currentReviewIndex += direction;
            
            if (currentReviewIndex < 0) {
                currentReviewIndex = reviews.length - 1;
            } else if (currentReviewIndex >= reviews.length) {
                currentReviewIndex = 0;
            }
            
            const animationDirection = direction > 0 ? 'left' : 'right';
            renderReview(currentReviewIndex, animationDirection);
        }

        function goToReview(index) {
            if (reviews.length === 0 || isAnimating) return;
            
            let animationDirection = null;
            if (index !== currentReviewIndex) {
                const forward = (index > currentReviewIndex) || (index === 0 && currentReviewIndex === reviews.length - 1);
                const backward = (index < currentReviewIndex) || (index === reviews.length - 1 && currentReviewIndex === 0);
                
                if (forward) {
                    animationDirection = 'left';
                } else if (backward) {
                    animationDirection = 'right';
                }
            }
            
            currentReviewIndex = index;
            renderReview(currentReviewIndex, animationDirection);
        }

        function checkRankUp() {
            const rankOrder = ['Bronze', 'Silver', 'Gold', 'Platinum', 'Diamond', 'Master', 'Legend'];
            
            const currentRank = '<%= rankName %>';
            const previousRank = localStorage.getItem('userRank');
            
            if (previousRank && previousRank !== currentRank) {
                const previousIndex = rankOrder.indexOf(previousRank);
                const currentIndex = rankOrder.indexOf(currentRank);
                
                if (currentIndex > previousIndex) {
                    celebrateRankUp(currentRank, previousRank);
                }
            }
            
            localStorage.setItem('userRank', currentRank);
        }
        
        function celebrateRankUp(newRank, oldRank) {
            const duration = 3000;
            const animationEnd = Date.now() + duration;
            const defaults = { startVelocity: 30, spread: 360, ticks: 60, zIndex: 0 };
            
            function randomInRange(min, max) {
                return Math.random() * (max - min) + min;
            }
            
            const interval = setInterval(function() {
                const timeLeft = animationEnd - Date.now();
                
                if (timeLeft <= 0) {
                    return clearInterval(interval);
                }
                
                const particleCount = 50 * (timeLeft / duration);
                
                confetti({
                    ...defaults,
                    particleCount,
                    origin: { x: randomInRange(0.1, 0.3), y: Math.random() - 0.2 }
                });
                confetti({
                    ...defaults,
                    particleCount,
                    origin: { x: randomInRange(0.7, 0.9), y: Math.random() - 0.2 }
                });
                confetti({
                    ...defaults,
                    particleCount,
                    origin: { x: randomInRange(0.4, 0.6), y: Math.random() - 0.2 }
                });
            }, 250);
            
            setTimeout(() => {
                Swal.fire({
                    title: '🎉 Rank Up! 🎉',
                    html: `
                        <div class="text-center space-y-4">
                            <div class="text-6xl mb-4">🏆</div>
                            <div class="text-2xl font-bold bg-gradient-to-r from-purple-400 to-pink-400 bg-clip-text text-transparent">
                                ${oldRank} → ${newRank}
                            </div>
                            <p class="text-gray-300 mt-4">Congratulations! You've reached a new rank!</p>
                            <p class="text-sm text-gray-400">You now have access to better discounts and benefits!</p>
                        </div>
                    `,
                    width: '500px',
                    padding: '2rem',
                    background: 'rgba(26, 26, 46, 0.95)',
                    backdrop: `
                        rgba(0, 0, 0, 0.4)
                        url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%239C92AC' fill-opacity='0.05'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E")
                        left top
                    `,
                    color: '#fff',
                    showConfirmButton: true,
                    confirmButtonText: 'Awesome!',
                    confirmButtonColor: '#8b5cf6',
                    buttonsStyling: true,
                    customClass: {
                        popup: 'spotlight-card border border-white/20',
                        title: 'text-white',
                        confirmButton: 'px-6 py-3 rounded-xl font-semibold bg-gradient-to-r from-purple-600 to-pink-600 hover:from-purple-500 hover:to-pink-500 transition-all'
                    },
                    allowOutsideClick: true,
                    allowEscapeKey: true
                });
            }, 500);
        }

        async function checkBannedStatus() {
            try {
                const token = localStorage.getItem('token') || document.cookie.split('; ').find(row => row.startsWith('token='))?.split('=')[1];
                if (!token) return;
                
                const response = await fetch(`${API_URL}/auth/me`, {
                    headers: { 'Authorization': `Bearer ${token}` }
                });
                
                if (response.ok) {
                    const data = await response.json();
                    if (data.user && data.user.banned === true) {
                        Swal.fire({
                            icon: 'error',
                            title: 'Account Banned',
                            html: `
                                <div class="text-left">
                                    <p class="mb-3">Your account has been banned.</p>
                                    <p class="text-sm text-gray-400"><strong>Reason:</strong> ${data.user.banReason || 'No reason provided'}</p>
                                </div>
                            `,
                            confirmButtonText: 'OK',
                            confirmButtonColor: '#d33',
                            allowOutsideClick: false,
                            allowEscapeKey: false
                        }).then(() => {
                            localStorage.removeItem('token');
                            localStorage.removeItem('user');
                            document.cookie = 'token=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/;';
                            window.location.href = '/login?banned=true&reason=' + encodeURIComponent(data.user.banReason || 'No reason provided');
                        });
                    }
                }
            } catch (error) {
                console.error('Error checking banned status:', error);
            }
        }

        document.addEventListener('DOMContentLoaded', () => {
            checkBannedStatus();
            
            setInterval(checkBannedStatus, 30000);
            
            loadPackages(1);
            
            checkRankUp();
            
            console.log('DOMContentLoaded - Reviews:', reviews);
            if (reviews && reviews.length > 0) {
                renderReview(0, null);
            } else {
                const reviewContainer = document.getElementById('review-container');
                if (reviewContainer) {
                    reviewContainer.innerHTML = `
                        <div class="spotlight-card rounded-xl p-6 bg-white/5 border border-white/10">
                            <div class="text-center text-gray-400 py-8">
                                <i class="fas fa-comments text-3xl mb-2 opacity-50"></i>
                                <p>No reviews yet</p>
                            </div>
                        </div>
                    `;
                }
            }
        });
    </script>
</body>
</html>

