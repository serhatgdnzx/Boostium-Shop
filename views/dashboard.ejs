                                <div id="discord-server-icon" class="w-16 h-16 rounded-xl bg-gradient-to-br from-purple-600 to-purple-800 flex items-center justify-center flex-shrink-0 overflow-hidden border-2 border-purple-500/30 shadow-lg">
