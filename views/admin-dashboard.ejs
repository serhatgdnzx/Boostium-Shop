<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title || 'Admin Dashboard | Boostium' %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Plus Jakarta Sans', 'sans-serif'],
                    },
                    colors: {
                        void: '#030014',
                        glass: 'rgba(255, 255, 255, 0.03)',
                        glassBorder: 'rgba(255, 255, 255, 0.08)',
                    }
                }
            }
        }
    </script>
    <style>
        body {
            background: linear-gradient(135deg, #030014 0%, #1a0a2e 100%);
            color: #ffffff;
            min-height: 100vh;
        }
        .spotlight-card {
            position: relative;
            overflow: hidden;
            background: rgba(255, 255, 255, 0.02);
            border: 1px solid rgba(255, 255, 255, 0.1);
            transition: all 0.3s;
        }
        .spotlight-card::before {
            content: "";
            position: absolute;
            background: radial-gradient(800px circle at var(--mouse-x) var(--mouse-y), rgba(255, 255, 255, 0.06), transparent 40%);
            z-index: 1;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            opacity: 0;
            transition: opacity 0.5s;
            pointer-events: none;
        }
        .spotlight-card:hover::before {
            opacity: 1;
        }
        .spotlight-card:hover {
            border-color: rgba(255, 255, 255, 0.2);
            transform: translateY(-2px);
        }
    </style>
</head>
<body class="font-sans">
    <!-- Navigation -->
    <nav class="bg-[#0a0a1a] border-b border-white/10 sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between items-center h-16">
                <div class="flex items-center gap-4">
                    <a href="/dashboard" class="text-xl font-bold bg-gradient-to-r from-purple-400 to-pink-400 bg-clip-text text-transparent">
                        <i class="fas fa-shield-alt mr-2"></i> Admin Panel
                    </a>
                </div>
                <div class="flex items-center gap-4">
                    <a href="/dashboard" class="text-gray-400 hover:text-white transition-colors">
                        <i class="fas fa-arrow-left mr-2"></i> Back to Dashboard
                    </a>
                    <button onclick="logout()" class="px-4 py-2 bg-red-600 hover:bg-red-700 rounded-lg transition-colors">
                        <i class="fas fa-sign-out-alt mr-2"></i> Logout
                    </button>
                </div>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <!-- Stats Overview -->
        <div class="mb-8">
            <h1 class="text-3xl font-bold mb-6">Dashboard Overview</h1>
            <div id="stats-container" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
                <!-- Stats will be loaded here -->
            </div>
        </div>

        <!-- Tabs -->
        <div class="mb-6">
            <div class="flex gap-2 border-b border-white/10">
                <button onclick="switchTab('users'); return false;" class="tab-btn px-6 py-3 font-medium transition-colors border-b-2 border-transparent hover:border-purple-500 text-gray-400" data-tab="users">
                    <i class="fas fa-users mr-2"></i> Users
                </button>
                <button onclick="switchTab('payments'); return false;" class="tab-btn px-6 py-3 font-medium transition-colors border-b-2 border-transparent hover:border-purple-500 text-gray-400" data-tab="payments">
                    <i class="fas fa-credit-card mr-2"></i> Payments
                </button>
                <button onclick="switchTab('boosts'); return false;" class="tab-btn px-6 py-3 font-medium transition-colors border-b-2 border-transparent hover:border-purple-500 text-gray-400" data-tab="boosts">
                    <i class="fas fa-rocket mr-2"></i> Boost Packages
                </button>
                <button onclick="switchTab('boost-purchases'); return false;" class="tab-btn px-6 py-3 font-medium transition-colors border-b-2 border-transparent hover:border-purple-500 text-gray-400" data-tab="boost-purchases">
                    <i class="fas fa-shopping-cart mr-2"></i> Boost Purchases
                </button>
                <button onclick="switchTab('settings'); return false;" class="tab-btn px-6 py-3 font-medium transition-colors border-b-2 border-transparent hover:border-purple-500 text-gray-400" data-tab="settings">
                    <i class="fas fa-cog mr-2"></i> Settings
                </button>
                <button onclick="switchTab('analytics'); return false;" class="tab-btn px-6 py-3 font-medium transition-colors border-b-2 border-transparent hover:border-purple-500 text-gray-400" data-tab="analytics">
                    <i class="fas fa-chart-line mr-2"></i> Analytics
                </button>
                <button onclick="switchTab('activity-logs'); return false;" class="tab-btn px-6 py-3 font-medium transition-colors border-b-2 border-transparent hover:border-purple-500 text-gray-400" data-tab="activity-logs">
                    <i class="fas fa-history mr-2"></i> Activity Logs
                </button>
                <button onclick="switchTab('promo-codes'); return false;" class="tab-btn px-6 py-3 font-medium transition-colors border-b-2 border-transparent hover:border-purple-500 text-gray-400" data-tab="promo-codes">
                    <i class="fas fa-ticket-alt mr-2"></i> Promo Codes
                </button>
                <button onclick="switchTab('system'); return false;" class="tab-btn px-6 py-3 font-medium transition-colors border-b-2 border-transparent hover:border-purple-500 text-gray-400" data-tab="system">
                    <i class="fas fa-server mr-2"></i> System
                </button>
            </div>
        </div>

        <!-- Tab Content -->
        <div id="tab-content" class="min-h-[400px]">
            <div class="text-center py-12 text-gray-400">
                <i class="fas fa-spinner fa-spin text-4xl mb-4"></i>
                <p>Loading...</p>
            </div>
        </div>
    </div>

    <script>
        const API_URL = '<%= apiUrl || "/api" %>';
        let currentTab = 'users';
        let currentPage = { users: 1, payments: 1, boosts: 1, 'boost-purchases': 1 };

        function getToken() {
            return localStorage.getItem('token') || document.cookie.split('; ').find(row => row.startsWith('token='))?.split('=')[1];
        }

        async function loadStats() {
            try {
                const token = getToken();
                if (!token) {
                    console.error('No token available');
                    return;
                }
                
                const response = await fetch(`${API_URL}/admin/stats`, {
                    headers: { 'Authorization': `Bearer ${token}` }
                });
                
                if (!response.ok) {
                    throw new Error(`HTTP error! status: ${response.status}`);
                }
                
                const data = await response.json();
                
                if (data.success) {
                    const stats = data.stats;
                    document.getElementById('stats-container').innerHTML = `
                        <div class="spotlight-card rounded-xl p-6">
                            <div class="flex items-center justify-between">
                                <div>
                                    <p class="text-gray-400 text-sm mb-1">Total Users</p>
                                    <p class="text-3xl font-bold text-white">${stats.totalUsers}</p>
                                </div>
                                <div class="w-12 h-12 bg-blue-500/20 rounded-lg flex items-center justify-center">
                                    <i class="fas fa-users text-blue-400 text-xl"></i>
                                </div>
                            </div>
                        </div>
                        <div class="spotlight-card rounded-xl p-6">
                            <div class="flex items-center justify-between">
                                <div>
                                    <p class="text-gray-400 text-sm mb-1">Total Revenue</p>
                                    <p class="text-3xl font-bold text-white">$${parseFloat(stats.totalRevenue).toLocaleString()}</p>
                                </div>
                                <div class="w-12 h-12 bg-green-500/20 rounded-lg flex items-center justify-center">
                                    <i class="fas fa-dollar-sign text-green-400 text-xl"></i>
                                </div>
                            </div>
                        </div>
                        <div class="spotlight-card rounded-xl p-6">
                            <div class="flex items-center justify-between">
                                <div>
                                    <p class="text-gray-400 text-sm mb-1">Total Payments</p>
                                    <p class="text-3xl font-bold text-white">${stats.completedPayments}/${stats.totalPayments}</p>
                                </div>
                                <div class="w-12 h-12 bg-purple-500/20 rounded-lg flex items-center justify-center">
                                    <i class="fas fa-credit-card text-purple-400 text-xl"></i>
                                </div>
                            </div>
                        </div>
                        <div class="spotlight-card rounded-xl p-6">
                            <div class="flex items-center justify-between">
                                <div>
                                    <p class="text-gray-400 text-sm mb-1">Boost Purchases</p>
                                    <p class="text-3xl font-bold text-white">${stats.totalBoostPurchases}</p>
                                </div>
                                <div class="w-12 h-12 bg-pink-500/20 rounded-lg flex items-center justify-center">
                                    <i class="fas fa-rocket text-pink-400 text-xl"></i>
                                </div>
                            </div>
                        </div>
                    `;
                }
            } catch (error) {
                console.error('Error loading stats:', error);
            }
        }


        async function loadTabContent(tab) {
            const content = document.getElementById('tab-content');
            if (!content) {
                console.error('Tab content element not found');
                return;
            }
            
            content.innerHTML = '<div class="text-center py-12"><i class="fas fa-spinner fa-spin text-4xl text-gray-400"></i></div>';

            try {
                switch(tab) {
                case 'users':
                    await loadUsers();
                    break;
                case 'payments':
                    await loadPayments();
                    break;
                case 'boosts':
                    await loadBoosts();
                    break;
                case 'boost-purchases':
                    await loadBoostPurchases();
                    break;
                case 'settings':
                    await loadSettings();
                    break;
                case 'analytics':
                    await loadAnalytics();
                    break;
                case 'activity-logs':
                    await loadActivityLogs();
                    break;
                case 'promo-codes':
                    await loadPromoCodes();
                    break;
                case 'system':
                    await loadSystem();
                    break;
                default:
                    console.error('Unknown tab:', tab);
                    content.innerHTML = '<div class="text-center py-12 text-red-400">Unknown tab</div>';
                }
            } catch (error) {
                console.error('Error loading tab content:', error);
                content.innerHTML = `<div class="text-center py-12 text-red-400">Error: ${error.message}</div>`;
            }
        }

        async function loadUsers(page = 1, search = '') {
            try {
                const token = getToken();
                if (!token) {
                    console.error('No token available');
                    document.getElementById('tab-content').innerHTML = '<div class="text-center py-12 text-red-400">Authentication required</div>';
                    return;
                }
                
                const url = `${API_URL}/admin/users?page=${page}&limit=20${search ? `&search=${encodeURIComponent(search)}` : ''}`;
                const response = await fetch(url, {
                    headers: { 'Authorization': `Bearer ${token}` }
                });
                
                if (!response.ok) {
                    throw new Error(`HTTP error! status: ${response.status}`);
                }
                
                const data = await response.json();
                
                if (data.success) {
                    let html = `
                        <div class="mb-4 flex justify-between items-center">
                            <input type="text" id="user-search" placeholder="Search users..." 
                                class="px-4 py-2 bg-white/5 border border-white/10 rounded-lg text-white placeholder-gray-400 focus:outline-none focus:border-purple-500 w-64"
                                onkeyup="searchUsers(event)">
                            <div class="flex gap-2">
                                <button onclick="showBulkOperations()" class="px-4 py-2 bg-orange-600 hover:bg-orange-700 rounded-lg transition-colors">
                                    <i class="fas fa-tasks mr-2"></i> Bulk Operations
                                </button>
                                <button onclick="showAddUserModal()" class="px-4 py-2 bg-purple-600 hover:bg-purple-700 rounded-lg transition-colors">
                                    <i class="fas fa-plus mr-2"></i> Add User
                                </button>
                            </div>
                        </div>
                        <div class="spotlight-card rounded-xl overflow-hidden">
                            <div class="overflow-x-auto">
                                <table class="w-full">
                                    <thead class="bg-white/5">
                                        <tr>
                                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-400 uppercase">User</th>
                                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-400 uppercase">Email</th>
                                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-400 uppercase">Balance</th>
                                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-400 uppercase">Rank</th>
                                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-400 uppercase">Status</th>
                                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-400 uppercase">Payments</th>
                                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-400 uppercase">Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody class="divide-y divide-white/5">
                    `;
                    
                    data.users.forEach(user => {
                        html += `
                            <tr class="hover:bg-white/5 transition-colors">
                                <td class="px-6 py-4">
                                    <div class="flex items-center gap-3">
                                        <div class="w-10 h-10 bg-gradient-to-br from-purple-500 to-pink-500 rounded-full flex items-center justify-center text-white font-bold">
                                            ${user.name.charAt(0).toUpperCase()}
                                        </div>
                                        <div>
                                            <p class="font-medium text-white">${user.name}</p>
                                            <p class="text-xs text-gray-400">${new Date(user.createdAt).toLocaleDateString()}</p>
                                        </div>
                                    </div>
                                </td>
                                <td class="px-6 py-4 text-gray-300">${user.email}</td>
                                <td class="px-6 py-4">
                                    <span class="text-green-400 font-semibold">$${parseFloat(user.UserBalance || 0).toFixed(2)}</span>
                                </td>
                                <td class="px-6 py-4">
                                    <span class="px-2 py-1 bg-purple-500/20 text-purple-300 rounded text-xs">${user.Rank || 'No Rank'}</span>
                                </td>
                                <td class="px-6 py-4">
                                    ${user.banned ? 
                                        `<span class="px-2 py-1 bg-red-500/20 text-red-300 rounded text-xs">Banned</span>` : 
                                        `<span class="px-2 py-1 bg-green-500/20 text-green-300 rounded text-xs">Active</span>`
                                    }
                                </td>
                                <td class="px-6 py-4 text-gray-300">${user.totalPayments || 0}</td>
                                <td class="px-6 py-4">
                                    <div class="flex gap-2">
                                        <button onclick="editUser('${user._id}')" class="px-3 py-1 bg-blue-600 hover:bg-blue-700 rounded text-sm transition-colors" title="Edit">
                                            <i class="fas fa-edit"></i>
                                        </button>
                                        ${user.banned ? 
                                            `<button onclick="unbanUser('${user._id}')" class="px-3 py-1 bg-green-600 hover:bg-green-700 rounded text-sm transition-colors" title="Unban">
                                                <i class="fas fa-unlock"></i>
                                            </button>` :
                                            `<button onclick="banUser('${user._id}', '${user.name}')" class="px-3 py-1 bg-orange-600 hover:bg-orange-700 rounded text-sm transition-colors" title="Ban">
                                                <i class="fas fa-ban"></i>
                                            </button>`
                                        }
                                        <button onclick="addNote('${user._id}')" class="px-3 py-1 bg-yellow-600 hover:bg-yellow-700 rounded text-sm transition-colors" title="Add Note">
                                            <i class="fas fa-sticky-note"></i>
                                        </button>
                                        <button onclick="deleteUser('${user._id}', '${user.name}')" class="px-3 py-1 bg-red-600 hover:bg-red-700 rounded text-sm transition-colors" title="Delete">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        `;
                    });
                    
                    html += `
                                    </tbody>
                                </table>
                            </div>
                        </div>
                        <div class="mt-4 flex justify-between items-center">
                            <p class="text-gray-400 text-sm">Page ${data.pagination.page} of ${data.pagination.pages}</p>
                            <div class="flex gap-2">
                                <button onclick="loadUsers(${data.pagination.page - 1})" ${data.pagination.page === 1 ? 'disabled' : ''} 
                                    class="px-4 py-2 bg-white/5 hover:bg-white/10 rounded-lg transition-colors disabled:opacity-50">
                                    Previous
                                </button>
                                <button onclick="loadUsers(${data.pagination.page + 1})" ${data.pagination.page === data.pagination.pages ? 'disabled' : ''} 
                                    class="px-4 py-2 bg-white/5 hover:bg-white/10 rounded-lg transition-colors disabled:opacity-50">
                                    Next
                                </button>
                            </div>
                        </div>
                    `;
                    
                    document.getElementById('tab-content').innerHTML = html;
                    currentPage.users = page;
                }
            } catch (error) {
                console.error('Error loading users:', error);
                document.getElementById('tab-content').innerHTML = '<div class="text-center py-12 text-red-400">Error loading users</div>';
            }
        }

        async function loadPayments(page = 1) {
            try {
                const response = await fetch(`${API_URL}/admin/payments?page=${page}&limit=50`, {
                    headers: { 'Authorization': `Bearer ${getToken()}` }
                });
                const data = await response.json();
                
                if (data.success) {
                    let html = `
                        <div class="spotlight-card rounded-xl overflow-hidden">
                            <div class="overflow-x-auto">
                                <table class="w-full">
                                    <thead class="bg-white/5">
                                        <tr>
                                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-400 uppercase">User</th>
                                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-400 uppercase">Amount</th>
                                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-400 uppercase">Method</th>
                                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-400 uppercase">Status</th>
                                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-400 uppercase">Date</th>
                                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-400 uppercase">Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody class="divide-y divide-white/5">
                    `;
                    
                    data.payments.forEach(payment => {
                        const statusColors = {
                            'confirmed': 'bg-green-500/20 text-green-300',
                            'finished': 'bg-green-500/20 text-green-300',
                            'waiting': 'bg-yellow-500/20 text-yellow-300',
                            'confirming': 'bg-blue-500/20 text-blue-300',
                            'failed': 'bg-red-500/20 text-red-300',
                            'expired': 'bg-gray-500/20 text-gray-300'
                        };
                        
                        html += `
                            <tr class="hover:bg-white/5 transition-colors">
                                <td class="px-6 py-4">
                                    <div>
                                        <p class="font-medium text-white">${payment.userName}</p>
                                        <p class="text-xs text-gray-400">${payment.userEmail}</p>
                                    </div>
                                </td>
                                <td class="px-6 py-4 text-green-400 font-semibold">$${parseFloat(payment.amount || 0).toFixed(2)}</td>
                                <td class="px-6 py-4 text-gray-300">${payment.paymentMethod || 'Crypto'}</td>
                                <td class="px-6 py-4">
                                    <span class="px-2 py-1 rounded text-xs ${statusColors[payment.status] || 'bg-gray-500/20 text-gray-300'}">
                                        ${payment.status || 'unknown'}
                                    </span>
                                </td>
                                <td class="px-6 py-4 text-gray-400 text-sm">${new Date(payment.createdAt).toLocaleString()}</td>
                                <td class="px-6 py-4">
                                    ${(payment.status === 'confirmed' || payment.status === 'finished') && payment.status !== 'refunded' ?
                                        `<button onclick="refundPayment('${payment.paymentId}', '${payment.userId}')" class="px-3 py-1 bg-orange-600 hover:bg-orange-700 rounded text-sm transition-colors" title="Refund">
                                            <i class="fas fa-undo"></i>
                                        </button>` : ''
                                    }
                                </td>
                            </tr>
                        `;
                    });
                    
                    html += `
                                    </tbody>
                                </table>
                            </div>
                        </div>
                        <div class="mt-4 flex justify-between items-center">
                            <p class="text-gray-400 text-sm">Page ${data.pagination.page} of ${data.pagination.pages}</p>
                            <div class="flex gap-2">
                                <button onclick="loadPayments(${data.pagination.page - 1})" ${data.pagination.page === 1 ? 'disabled' : ''} 
                                    class="px-4 py-2 bg-white/5 hover:bg-white/10 rounded-lg transition-colors disabled:opacity-50">
                                    Previous
                                </button>
                                <button onclick="loadPayments(${data.pagination.page + 1})" ${data.pagination.page === data.pagination.pages ? 'disabled' : ''} 
                                    class="px-4 py-2 bg-white/5 hover:bg-white/10 rounded-lg transition-colors disabled:opacity-50">
                                    Next
                                </button>
                            </div>
                        </div>
                    `;
                    
                    document.getElementById('tab-content').innerHTML = html;
                    currentPage.payments = page;
                }
            } catch (error) {
                console.error('Error loading payments:', error);
                document.getElementById('tab-content').innerHTML = '<div class="text-center py-12 text-red-400">Error loading payments</div>';
            }
        }

        async function loadBoosts() {
            try {
                const response = await fetch(`${API_URL}/admin/boosts`, {
                    headers: { 'Authorization': `Bearer ${getToken()}` }
                });
                const data = await response.json();
                
                if (data.success) {
                    let html = `
                        <div class="mb-4">
                            <button onclick="showAddBoostModal()" class="px-4 py-2 bg-purple-600 hover:bg-purple-700 rounded-lg transition-colors">
                                <i class="fas fa-plus mr-2"></i> Add Boost Package
                            </button>
                        </div>
                        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                    `;
                    
                    data.packages.forEach(pkg => {
                        html += `
                            <div class="spotlight-card rounded-xl p-6">
                                <div class="flex justify-between items-start mb-4">
                                    <div>
                                        <h3 class="text-xl font-bold text-white mb-1">${pkg.name || `${pkg.quantity} Boosts`}</h3>
                                        <p class="text-gray-400 text-sm">${pkg.quantity} members • ${pkg.duration} month${pkg.duration > 1 ? 's' : ''}</p>
                                        <p class="text-gray-400 text-sm">$${pkg.pricePerBoost ? pkg.pricePerBoost.toFixed(2) : '0.00'} per boost</p>
                                    </div>
                                    <div class="text-right">
                                        <p class="text-2xl font-bold text-green-400">$${pkg.price}</p>
                                    </div>
                                </div>
                                <div class="mb-4">
                                    <span class="px-3 py-1 rounded-full text-xs font-semibold ${
                                        pkg.inStock ? 'bg-green-500/20 text-green-300' : 'bg-red-500/20 text-red-300'
                                    }">
                                        ${pkg.inStock ? 'In Stock' : 'Out of Stock'}
                                    </span>
                                </div>
                                <div class="flex gap-2 mt-4">
                                    <button onclick="toggleBoostStock('${pkg._id}', ${!pkg.inStock})" 
                                        class="px-3 py-2 ${pkg.inStock ? 'bg-orange-600 hover:bg-orange-700' : 'bg-green-600 hover:bg-green-700'} rounded-lg transition-colors">
