        async function toggleMaintenance() {
            try {
                const settingsResponse = await fetch(`${API_URL}/admin/settings`, {
                    headers: { 'Authorization': `Bearer ${getToken()}` }
                });
                const settingsData = await settingsResponse.json();
                
                console.log('Current settings:', settingsData);
                
                if (!settingsData.success) {
                    Swal.fire('Error', 'Failed to fetch current settings', 'error');
                    return;
                }
                
                const currentMaintenanceMode = settingsData.settings?.GeneralSettings?.maintenanceMode;
                const currentStatus = currentMaintenanceMode === true || currentMaintenanceMode === 'true';
                console.log('Current maintenance status:', currentStatus);
                console.log('Current maintenance mode value:', currentMaintenanceMode);
                console.log('Current maintenance mode type:', typeof currentMaintenanceMode);
                
                const { value: message, isConfirmed } = await Swal.fire({
                    title: `${currentStatus ? 'Disable' : 'Enable'} Maintenance Mode?`,
                    input: 'textarea',
                    inputLabel: 'Maintenance Message (optional)',
                    inputPlaceholder: 'Site is under maintenance...',
                    showCancelButton: true,
                    confirmButtonText: currentStatus ? 'Disable' : 'Enable',
                    confirmButtonColor: currentStatus ? '#d33' : '#28a745',
                    inputValue: settingsData.settings.GeneralSettings?.maintenanceMessage || ''
                });
                
                if (isConfirmed) {
                    const newStatus = !currentStatus;
                    console.log('Setting maintenance to:', newStatus);
                    
                    try {
                        const response = await fetch(`${API_URL}/admin/maintenance`, {
                            method: 'POST',
                            headers: {
                                'Authorization': `Bearer ${getToken()}`,
                                'Content-Type': 'application/json'
                            },
                            body: JSON.stringify({
                                enabled: newStatus,
                                message: message || 'Site is under maintenance. Please check back later.'
                            })
                        });
                        
                        const data = await response.json();
                        console.log('Maintenance response:', data);
                        
                        if (data.success) {
                            Swal.fire('Success!', `Maintenance mode ${newStatus ? 'enabled' : 'disabled'}`, 'success');
                            setTimeout(() => {
                                loadSystem();
                            }, 500);
                        } else {
                            Swal.fire('Error', data.message || 'Failed to update maintenance mode', 'error');
                        }
                    } catch (error) {
                        console.error('Maintenance toggle error:', error);
                        Swal.fire('Error', error.message || 'Failed to update maintenance mode', 'error');
                    }
                }
            } catch (error) {
                console.error('Error fetching settings:', error);
                Swal.fire('Error', 'Failed to fetch current settings', 'error');
            }
        }

        function showAddPromoModal() {
            Swal.fire({
                title: 'Add Promo Code',
                html: `
                    <div class="text-left space-y-4">
                        <div>
                            <label class="block text-sm font-medium mb-1">Code</label>
                            <input id="promo-code" type="text" class="w-full px-3 py-2 border rounded" placeholder="PROMO2024">
                        </div>
                        <div>
                            <label class="block text-sm font-medium mb-1">Discount Type</label>
                            <select id="promo-type" class="w-full px-3 py-2 border rounded">
                                <option value="percentage">Percentage</option>
                                <option value="fixed">Fixed Amount</option>
                            </select>
                        </div>
                        <div>
                            <label class="block text-sm font-medium mb-1">Discount Value</label>
                            <input id="promo-value" type="number" step="0.01" class="w-full px-3 py-2 border rounded">
                        </div>
                        <div>
                            <label class="block text-sm font-medium mb-1">Min Amount ($)</label>
                            <input id="promo-min" type="number" step="0.01" value="0" class="w-full px-3 py-2 border rounded">
                        </div>
                        <div>
                            <label class="block text-sm font-medium mb-1">Max Uses (leave empty for unlimited)</label>
                            <input id="promo-max" type="number" class="w-full px-3 py-2 border rounded">
                        </div>
                        <div>
                            <label class="block text-sm font-medium mb-1">Valid Until (optional)</label>
                            <input id="promo-until" type="date" class="w-full px-3 py-2 border rounded">
                        </div>
                    </div>
                `,
                showCancelButton: true,
                confirmButtonText: 'Create',
                preConfirm: async () => {
                    const code = document.getElementById('promo-code').value;
                    const type = document.getElementById('promo-type').value;
                    const value = document.getElementById('promo-value').value;
                    const min = document.getElementById('promo-min').value;
                    const max = document.getElementById('promo-max').value;
                    const until = document.getElementById('promo-until').value;
                    
                    if (!code || !value) {
                        Swal.showValidationMessage('Code and value are required');
                        return false;
                    }
                    
                    const response = await fetch(`${API_URL}/admin/promo-codes`, {
                        method: 'POST',
                        headers: {
                            'Authorization': `Bearer ${getToken()}`,
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify({
                            code,
                            discountType: type,
                            discountValue: parseFloat(value),
                            minAmount: parseFloat(min) || 0,
                            maxUses: max ? parseInt(max) : null,
                            validUntil: until || null
                        })
                    });
                    
                    const data = await response.json();
                    if (!data.success) throw new Error(data.message);
                    return data;
                }
            }).then((result) => {
                if (result.isConfirmed) {
                    Swal.fire('Success!', 'Promo code created', 'success');
                    loadPromoCodes();
                }
            });
        }

