                                </div>
                                <div>
                                    <label class="block text-sm font-medium mb-1">Active</label>
                                    <select id="edit-promo-active" class="w-full px-3 py-2 border rounded">
                                        <option value="true" ${promo.active ? 'selected' : ''}>Active</option>
                                        <option value="false" ${!promo.active ? 'selected' : ''}>Inactive</option>
                                    </select>
                                </div>
                                <div>
                                    <label class="block text-sm font-medium mb-1">Valid Until (optional)</label>
                                    <input id="edit-promo-until" type="date" 
                                        value="${promo.validUntil ? new Date(promo.validUntil).toISOString().split('T')[0] : ''}"
                                        class="w-full px-3 py-2 border rounded">
                                </div>
                            </div>
                        `,
                        showCancelButton: true,
                        confirmButtonText: 'Save',
                        preConfirm: async () => {
                            const value = document.getElementById('edit-promo-value').value;
                            const active = document.getElementById('edit-promo-active').value === 'true';
                            const until = document.getElementById('edit-promo-until').value;
                            
                            const updateResponse = await fetch(`${API_URL}/admin/promo-codes/${codeId}`, {
                                method: 'PUT',
                                headers: {
                                    'Authorization': `Bearer ${getToken()}`,
                                    'Content-Type': 'application/json'
                                },
                                body: JSON.stringify({
                                    discountValue: parseFloat(value),
                                    active,
                                    validUntil: until || null
                                })
                            });
                            
                            const updateData = await updateResponse.json();
                            if (!updateData.success) throw new Error(updateData.message);
                            return updateData;
                        }
                    });
                    
                    if (formValues) {
                        Swal.fire('Success!', 'Promo code updated', 'success');
                        loadPromoCodes();
                    }
                }
            } catch (error) {
                Swal.fire('Error', error.message, 'error');
            }
        }

        async function deletePromoCode(codeId) {
            Swal.fire({
                title: 'Delete Promo Code?',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Yes, delete!'
            }).then(async (result) => {
                if (result.isConfirmed) {
                    try {
                        const response = await fetch(`${API_URL}/admin/promo-codes/${codeId}`, {
                            method: 'DELETE',
                            headers: { 'Authorization': `Bearer ${getToken()}` }
                        });
                        const data = await response.json();
                        
                        if (data.success) {
                            Swal.fire('Deleted!', 'Promo code deleted', 'success');
                            loadPromoCodes();
                        } else {
                            Swal.fire('Error', data.message, 'error');
                        }
                    } catch (error) {
                        Swal.fire('Error', error.message, 'error');
                    }
                }
            });
        }


        function logout() {
            localStorage.removeItem('token');
            document.cookie = 'token=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/;';
            window.location.href = '/login';
        }

        window.switchTab = function(tab) {
            console.log('Switching to tab:', tab);
            currentTab = tab;
            
            document.querySelectorAll('.tab-btn').forEach(btn => {
                if (btn.dataset.tab === tab) {
                    btn.classList.add('border-purple-500', 'text-purple-400');
                    btn.classList.remove('border-transparent', 'text-gray-400');
                } else {
                    btn.classList.remove('border-purple-500', 'text-purple-400');
                    btn.classList.add('border-transparent', 'text-gray-400');
                }
            });
            
            loadTabContent(tab);
        };

        document.addEventListener('DOMContentLoaded', () => {
            console.log('Admin dashboard initialized');
            console.log('API_URL:', API_URL);
            console.log('Token:', getToken() ? 'Token found' : 'No token');
            console.log('switchTab function:', typeof window.switchTab);
            
            if (!getToken()) {
                console.error('No token found, redirecting to login');
                window.location.href = '/login';
                return;
            }
            
            loadStats();
            switchTab('users');
            
            document.querySelectorAll('.spotlight-card').forEach(card => {
                card.addEventListener('mousemove', (e) => {
                    const rect = card.getBoundingClientRect();
                    const x = e.clientX - rect.left;
                    const y = e.clientY - rect.top;
                    card.style.setProperty('--mouse-x', `${x}px`);
                    card.style.setProperty('--mouse-y', `${y}px`);
                });
            });
        });
        
        window.addEventListener('error', (e) => {
            console.error('JavaScript error:', e.error);
        });
    </script>
</body>
</html>

