            </div>

            <div class="mb-6 p-4 rounded-lg bg-amber-500/10 border border-amber-500/30 hover:border-amber-500/40 transition-all duration-200">
                <div class="flex justify-between items-center">
                    <div>
                        <div class="text-sm font-medium text-amber-400 mb-1 flex items-center gap-2">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-info w-4 h-4">
                                <circle cx="12" cy="12" r="10"></circle>
                                <path d="M12 16v-4"></path>
                                <path d="M12 8h.01"></path>
                            </svg>
                            Your Username (needed for checkout)
                        </div>
                        <div class="text-white font-mono bg-amber-500/10 px-3 py-1.5 rounded border border-amber-500/20 inline-block" id="username-text">
                            <%= (typeof userStats !== 'undefined' && userStats && userStats.name) ? userStats.name : 'Guest' %>
                        </div>
