        </div>
    </div>

    <!-- Spotlight Effect Script -->
    <script>
        const cards = document.querySelectorAll('.spotlight-card');
        
        cards.forEach(card => {
            card.addEventListener('mousemove', (e) => {
                const rect = card.getBoundingClientRect();
                const x = e.clientX - rect.left;
                const y = e.clientY - rect.top;
                card.style.setProperty('--mouse-x', `${x}px`);
                card.style.setProperty('--mouse-y', `${y}px`);
            });
        });

        const API_URL = '<%= apiUrl || "/api" %>';

        let selectedPaymentMethod = 'crypto'; // Only crypto available
        let selectedCurrency = 'BTC'; // Default to BTC

        const currencySelectBtn = document.getElementById('currency-select-btn');
        const currencyDropdown = document.getElementById('currency-dropdown-menu');
        const selectedCurrencyName = document.getElementById('selected-currency-name');
        const selectedCurrencyIconContainer = document.getElementById('selected-currency-icon-container');
        const currencyChevron = document.getElementById('currency-chevron');

        const currencyData = {
            'BTC': {
                name: 'Bitcoin',
                icon: `<svg stroke="currentColor" fill="currentColor" stroke-width="0" viewBox="0 0 512 512" class="w-8 h-8 text-[#F7931A]"><path d="M504 256c0 136.967-111.033 248-248 248S8 392.967 8 256 119.033 8 256 8s248 111.033 248 248zm-141.651-35.33c4.937-32.999-20.191-50.739-54.55-62.573l11.146-44.702-27.213-6.781-10.851 43.524c-7.154-1.783-14.502-3.464-21.803-5.13l10.929-43.81-27.198-6.781-11.153 44.686c-5.922-1.349-11.735-2.682-17.377-4.084l.031-.14-37.53-9.37-7.239 29.062s20.191 4.627 19.765 4.913c11.022 2.751 13.014 10.044 12.68 15.825l-12.696 50.925c.76.194 1.744.473 2.829.907-.907-.225-1.876-.473-2.876-.713l-17.796 71.338c-1.349 3.348-4.767 8.37-12.471 6.464.271.395-19.78-4.937-19.78-4.937l-13.51 31.147 35.414 8.827c6.588 1.651 13.045 3.379 19.4 5.006l-11.262 45.213 27.182 6.781 11.153-44.733a1038.209 1038.209 0 0 0 21.687 5.627l-11.115 44.523 27.213 6.781 11.262-45.128c46.404 8.781 81.299 5.239 95.986-36.727 11.836-33.79-.589-53.281-25.004-65.991 17.78-4.098 31.174-15.792 34.747-39.949zm-62.177 87.179c-8.41 33.79-65.308 15.523-83.755 10.943l14.944-59.899c18.446 4.603 77.6 13.717 68.811 48.956zm8.417-87.667c-7.673 30.736-55.031 15.12-70.393 11.292l13.548-54.327c15.363 3.828 64.836 10.973 56.845 43.035z"></path></svg>`,
                color: '#F7931A'
            },
            'USDTTRX': {
                name: 'Tether',
                icon: `<img src="https://assets.coingecko.com/coins/images/325/large/Tether.png" alt="USDT" class="w-8 h-8 rounded-full">`,
                color: '#ef0027'
            },
            'TRX': {
                name: 'TRON',
                icon: `<img src="https://assets.coingecko.com/coins/images/1094/large/tron-logo.png" alt="TRX" class="w-8 h-8 rounded-full">`,
                color: '#ff0019'
            }
        };

        function updateSelectedCurrency(currency) {
            const data = currencyData[currency];
            if (data) {
                selectedCurrencyName.textContent = data.name;
                selectedCurrencyIconContainer.innerHTML = data.icon;
            }
        }

        if (currencySelectBtn && currencyDropdown) {
            currencySelectBtn.addEventListener('click', function(e) {
                e.stopPropagation();
                const isOpen = !currencyDropdown.classList.contains('hidden');
                
                if (isOpen) {
                    currencyDropdown.classList.add('hidden');
                    currencyChevron.style.transform = 'rotate(0deg)';
                } else {
                    currencyDropdown.classList.remove('hidden');
                    currencyChevron.style.transform = 'rotate(180deg)';
                }
            });

            document.addEventListener('click', function(e) {
                const container = document.getElementById('currency-dropdown-container');
                if (container && !container.contains(e.target)) {
                    currencyDropdown.classList.add('hidden');
                    currencyChevron.style.transform = 'rotate(0deg)';
                }
            });

            document.querySelectorAll('.currency-option').forEach(option => {
                option.addEventListener('click', function(e) {
                    e.stopPropagation();
                    const currency = this.getAttribute('data-currency');
                    selectedCurrency = currency;

                    updateSelectedCurrency(currency);

                    document.querySelectorAll('.currency-check').forEach(check => {
                        check.classList.add('hidden');
                    });
                    const checkIcon = this.querySelector('.currency-check');
                    if (checkIcon) {
                        checkIcon.classList.remove('hidden');
                    }

                    currencyDropdown.classList.add('hidden');
                    currencyChevron.style.transform = 'rotate(0deg)';
                });
            });
        }

        updateSelectedCurrency('BTC');

        let selectedBalanceAmount = null;

        const amountInput = document.getElementById('amount');
        const MIN_AMOUNT = 20; // Minimum $20
        
        if (amountInput) {
            amountInput.addEventListener('input', function() {
                const value = parseFloat(this.value) || 0;
                
                if (value > 0 && value < MIN_AMOUNT) {
                    this.setCustomValidity(`Minimum amount must be $${MIN_AMOUNT}`);
                    this.reportValidity();
                    selectedBalanceAmount = null;
                } else if (value >= MIN_AMOUNT) {
                    this.setCustomValidity('');
                    selectedBalanceAmount = value;
                } else {
                    this.setCustomValidity('');
                    selectedBalanceAmount = null;
                }
                
                updatePaymentSummary();
                updateProceedButton();
            });
            
            amountInput.addEventListener('blur', function() {
                const value = parseFloat(this.value) || 0;
                if (value > 0 && value < MIN_AMOUNT) {
                    this.value = MIN_AMOUNT.toFixed(2);
                    selectedBalanceAmount = MIN_AMOUNT;
                    updatePaymentSummary();
                    updateProceedButton();
                }
            });
        }

        document.querySelectorAll('[data-preset-amount]')?.forEach(btn => {
            btn.addEventListener('click', function() {
                const amount = parseFloat(this.getAttribute('data-preset-amount'));
                selectedBalanceAmount = amount;
                
                if (amountInput) {
                    amountInput.value = amount.toFixed(2);
                }
                
                document.querySelectorAll('[data-preset-amount]').forEach(b => {
                    b.classList.remove('bg-gradient-to-r', 'from-purple-500/20', 'to-fuchsia-500/20', 'border-purple-500/30', 'text-purple-400');
                    b.classList.add('bg-zinc-800/50', 'border-zinc-700/50', 'text-zinc-400');
                });
                
                this.classList.add('bg-gradient-to-r', 'from-purple-500/20', 'to-fuchsia-500/20', 'border-purple-500/30', 'text-purple-400');
                this.classList.remove('bg-zinc-800/50', 'border-zinc-700/50', 'text-zinc-400');
                
                updatePaymentSummary();
                updateProceedButton();
            });
        });

        function selectBalanceAmount(amount) {
            selectedBalanceAmount = amount;
            
            document.querySelectorAll('.balance-option').forEach(btn => {
                btn.classList.remove('border-purple-500', 'bg-purple-500/20');
                btn.classList.add('border-white/10');
            });
            
            const selectedBtn = document.querySelector(`[data-amount="${amount}"]`);
            if (selectedBtn) {
                selectedBtn.classList.add('border-purple-500', 'bg-purple-500/20');
                selectedBtn.classList.remove('border-white/10');
            }
            
            document.getElementById('custom-balance-amount').value = amount.toFixed(2);
            
            updateAddBalanceButton();
        }

        function handleCustomAmountInput() {
            const customInput = document.getElementById('custom-balance-amount');
            const value = parseFloat(customInput.value);
            
            if (!isNaN(value) && value > 0) {
                selectedBalanceAmount = value;
                
                document.querySelectorAll('.balance-option').forEach(btn => {
                    btn.classList.remove('border-purple-500', 'bg-purple-500/20');
                    btn.classList.add('border-white/10');
                });
            } else {
                selectedBalanceAmount = null;
            }
            
            updateAddBalanceButton();
        }

        function updateAddBalanceButton() {
            const addBalanceBtn = document.getElementById('add-balance-btn');
            const addBalanceText = document.getElementById('add-balance-text');
            
            if (selectedBalanceAmount && selectedBalanceAmount > 0) {
                addBalanceBtn.disabled = false;
                addBalanceText.textContent = `Proceed to Payment`;
            } else {
                addBalanceBtn.disabled = true;
                addBalanceText.textContent = 'Select or enter amount';
            }
        }

        function updatePaymentSummary() {
            const summaryAmount = document.querySelector('[data-summary-amount]');
            if (summaryAmount) {
                if (selectedBalanceAmount && selectedBalanceAmount > 0) {
                    summaryAmount.textContent = `$${selectedBalanceAmount.toFixed(2)}`;
                } else {
                    summaryAmount.textContent = '$0.00';
                }
            }
        }

        function updateProceedButton() {
            const proceedBtn = document.querySelector('[type="submit"]');
            const MIN_AMOUNT = 20; // Minimum $20
            
            if (proceedBtn) {
                if (selectedBalanceAmount && selectedBalanceAmount >= MIN_AMOUNT) {
                    proceedBtn.disabled = false;
                    proceedBtn.classList.remove('bg-zinc-800', 'cursor-not-allowed', 'opacity-50');
                    proceedBtn.classList.add('bg-gradient-to-r', 'from-purple-600', 'to-pink-600', 'hover:from-purple-500', 'hover:to-pink-500');
                } else {
                    proceedBtn.disabled = true;
                    proceedBtn.classList.add('bg-zinc-800', 'cursor-not-allowed', 'opacity-50');
                    proceedBtn.classList.remove('bg-gradient-to-r', 'from-purple-600', 'to-pink-600', 'hover:from-purple-500', 'hover:to-pink-500');
                }
            }
        }

        const paymentForm = document.querySelector('form') || document.querySelector('.spotlight-card');
        if (paymentForm && !paymentForm.hasAttribute('data-listener-added')) {
            paymentForm.setAttribute('data-listener-added', 'true');
            
            const proceedBtn = document.querySelector('[type="submit"]');
            if (proceedBtn) {
                proceedBtn.addEventListener('click', async (e) => {
                    e.preventDefault();
                    await handleAddBalance();
                });
            }
        }

        async function handleAddBalance() {
            const MIN_AMOUNT = 20; // Minimum $20
            
            if (!selectedBalanceAmount || selectedBalanceAmount <= 0) {
                Swal.fire({
                    title: 'Invalid Amount',
                    text: 'Please select or enter a valid amount',
                    icon: 'warning',
                    background: '#030014',
                    color: '#e5e7eb',
                    confirmButtonText: 'OK',
                    confirmButtonColor: '#4f46e5'
                });
                return;
            }

            if (selectedBalanceAmount < MIN_AMOUNT) {
                Swal.fire({
                    title: 'Minimum Amount Required',
                    text: `Minimum payment amount must be $${MIN_AMOUNT}`,
                    icon: 'warning',
                    background: '#030014',
                    color: '#e5e7eb',
                    confirmButtonText: 'OK',
                    confirmButtonColor: '#4f46e5'
                });
                return;
            }

            if (!selectedPaymentMethod) {
                Swal.fire({
                    title: 'Payment Method Required',
                    text: 'Please select a payment method',
                    icon: 'warning',
                    background: '#030014',
                    color: '#e5e7eb',
                    confirmButtonText: 'OK',
                    confirmButtonColor: '#4f46e5'
                });
                return;
            }

            const proceedBtn = document.querySelector('[type="submit"]');
            const originalText = proceedBtn ? proceedBtn.innerHTML : '';
            
            if (proceedBtn) {
                proceedBtn.disabled = true;
                proceedBtn.innerHTML = '<i class="fas fa-spinner fa-spin mr-2"></i> Creating checkout...';
            }

            try {
                const token = localStorage.getItem('token') || document.cookie.split('; ').find(row => row.startsWith('token='))?.split('=')[1];
                
                if (!selectedCurrency) {
                    Swal.fire({
                        title: 'Currency Required',
                        text: 'Please select a payment currency',
                        icon: 'warning',
                        background: '#030014',
                        color: '#e5e7eb',
                        confirmButtonText: 'OK',
                        confirmButtonColor: '#4f46e5'
                    });
                    
                    if (proceedBtn) {
                        proceedBtn.disabled = false;
                        proceedBtn.innerHTML = originalText;
                    }
                    return;
                }

                const response = await fetch(`${API_URL}/auth/balance/create-checkout`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': `Bearer ${token}`
                    },
                    body: JSON.stringify({
                        amount: selectedBalanceAmount,
                        paymentMethod: selectedPaymentMethod,
                        currency: selectedCurrency
                    })
                });

                const data = await response.json();

                if (data.success) {
                    if (data.nowpayments) {
                        const orderIdElement = document.createElement('div');
                        orderIdElement.setAttribute('data-order-id', data.orderId || '');
                        orderIdElement.style.display = 'none';
                        document.body.appendChild(orderIdElement);
                        
                        showNOWPaymentsModal(data.paymentId, data.invoiceId, data.btcAmount, data.btcAddress, data.amount, data.paymentUrl, data.payCurrency || 'BTC', data.testMode || false);
                    } else if (data.embedMode && data.checkoutUrl) {
                        showPaymentModal(data.checkoutUrl, data.amount, data.variantId, data.selectedVariantTitle);
                    } else if (data.checkoutUrl) {
                        window.location.href = data.checkoutUrl;
                    } else {
                        throw new Error('Payment information could not be retrieved');
                    }
                } else {
                    throw new Error(data.message || 'Checkout oluşturulamadı');
                }
            } catch (error) {
                console.error('Error creating checkout:', error);
                Swal.fire({
                    title: 'Error',
                    text: error.message || 'An error occurred while creating checkout. Please try again.',
                    icon: 'error',
                    background: '#030014',
                    color: '#e5e7eb',
                    confirmButtonText: 'OK',
                    confirmButtonColor: '#ef4444'
                });
                
                if (proceedBtn) {
                    proceedBtn.disabled = false;
                    proceedBtn.innerHTML = originalText;
                }
