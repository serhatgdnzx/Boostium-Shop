                            </div>
                        </button>
                        
                        <!-- Tether USDT (TRX) -->
                        <button type="button" data-currency="USDTTRX" class="currency-option w-full flex items-center gap-3 p-4 hover:bg-red-500/10 transition-colors border-b border-white/5">
                            <div class="w-10 h-10 flex items-center justify-center bg-white/10 rounded-full p-2">
                                <img src="https://assets.coingecko.com/coins/images/325/large/Tether.png" alt="USDT" class="w-8 h-8 rounded-full">
                            </div>
                            <div class="flex-1 text-left">
                                <div class="font-medium text-white">Tether</div>
                                <div class="text-xs text-gray-400">USDT (TRON)</div>
                            </div>
                            <div class="px-2 py-1 bg-red-500/20 border border-red-500/30 rounded text-xs font-semibold text-red-300">
                                TRX
                            </div>
                            <div class="text-red-400 hidden currency-check">
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
