        };
        
        window.copyCryptoAmount = function() {
            const input = document.getElementById('crypto-amount-input');
            if (input) {
                input.select();
                document.execCommand('copy');
                Swal.fire({
                    title: 'Copied!',
                    text: 'Amount copied to clipboard',
                    icon: 'success',
                    background: '#030014',
                    color: '#e5e7eb',
                    timer: 2000,
                    showConfirmButton: false
                });
            }
        };
        
        window.simulateTestPayment = async function(paymentId, invoiceId, usdAmount, cryptoAmount, cryptoAddress, payCurrency) {
            if (!confirm('🧪 Payment will be simulated in test mode. Do you want to continue?')) {
                return;
            }
            
            try {
                const token = localStorage.getItem('token') || document.cookie.split('; ').find(row => row.startsWith('token='))?.split('=')[1];
                const response = await fetch(`${API_URL}/auth/balance/check-payment-status?paymentId=${paymentId}&forceStatus=confirmed&amount=${usdAmount}&cryptoAmount=${cryptoAmount}&cryptoAddress=${encodeURIComponent(cryptoAddress)}&payCurrency=${payCurrency || 'BTC'}&orderId=${document.querySelector('[data-order-id]')?.getAttribute('data-order-id') || ''}`, {
                    headers: {
                        'Authorization': `Bearer ${token}`
                    }
                });
                
                const data = await response.json();
                
                if (data.success && data.status === 'confirmed') {
                    if (window.paymentStatusInterval) {
                        clearInterval(window.paymentStatusInterval);
                    }
                    closePaymentModal();
                    
                    Swal.fire({
                        title: '✅ Test Payment Successful!',
                        text: `$${usdAmount} has been added to your balance (TEST MODE).`,
                        icon: 'success',
                        background: '#030014',
                        color: '#e5e7eb',
                        confirmButtonText: 'OK',
                        confirmButtonColor: '#10b981'
                    }).then(() => {
                        window.location.href = '/dashboard';
                    });
                }
            } catch (error) {
                console.error('Test payment simulation error:', error);
                Swal.fire({
                    title: 'Error',
                    text: 'Test payment simulation failed.',
                    icon: 'error',
                    background: '#030014',
                    color: '#e5e7eb',
                    confirmButtonText: 'OK',
                    confirmButtonColor: '#ef4444'
                });
            }
        };
        
        window.checkPaymentStatus = async function(paymentId, usdAmount, cryptoAmount, cryptoAddress, payCurrency) {
            if (!paymentId) return;
            
            const refreshBtn = document.getElementById('refresh-status-btn');
            if (refreshBtn) {
                refreshBtn.disabled = true;
                refreshBtn.innerHTML = '<i class="fas fa-spinner fa-spin mr-2"></i> Checking...';
            }
            
            try {
                const token = localStorage.getItem('token') || document.cookie.split('; ').find(row => row.startsWith('token='))?.split('=')[1];
                
                const orderId = document.querySelector('[data-order-id]')?.getAttribute('data-order-id') || '';
                
                let url = `${API_URL}/auth/balance/check-payment-status?paymentId=${paymentId}`;
                if (orderId) {
                    url += `&orderId=${encodeURIComponent(orderId)}`;
                }
                if (usdAmount) {
                    url += `&amount=${usdAmount}`;
                }
                if (cryptoAmount) {
                    url += `&cryptoAmount=${cryptoAmount}`;
                }
                if (cryptoAddress) {
                    url += `&cryptoAddress=${encodeURIComponent(cryptoAddress)}`;
                }
                if (payCurrency) {
                    url += `&payCurrency=${payCurrency}`;
                }
                
                const response = await fetch(url, {
                    headers: {
                        'Authorization': `Bearer ${token}`
                    }
                });
                
                const data = await response.json();
                
                if (data.success && (data.status === 'confirmed' || data.status === 'finished')) {
                    if (window.paymentStatusInterval) {
                        clearInterval(window.paymentStatusInterval);
                    }
                    
                    const statusText = document.getElementById('payment-status-text');
                    const statusSpinner = document.getElementById('status-spinner');
                    if (statusText) {
                        statusText.textContent = 'Status: Confirmed';
                        statusText.className = 'text-green-400 font-medium';
                    }
                    if (statusSpinner) {
                        statusSpinner.className = 'w-5 h-5 border-2 border-green-500 border-t-transparent rounded-full animate-spin';
                    }
                    
                    setTimeout(() => {
                        closePaymentModal();
                        const modeText = data.testMode ? ' (TEST MODE)' : '';
                        Swal.fire({
                            title: 'Payment Successful!',
                            text: `$${data.amount || usdAmount} has been added to your balance.${modeText}`,
                            icon: 'success',
                            background: '#030014',
                            color: '#e5e7eb',
                            confirmButtonText: 'OK',
                            confirmButtonColor: '#10b981'
                        }).then(() => {
                            window.location.href = '/dashboard';
                        });
                    }, 1500);
                } else {
                    const statusText = document.getElementById('payment-status-text');
                    if (statusText && data.status) {
                        const statusMap = {
                            'waiting': { text: 'Status: Waiting', color: 'text-yellow-400' },
                            'confirming': { text: 'Status: Confirming', color: 'text-yellow-400' },
                            'sending': { text: 'Status: Sending', color: 'text-blue-400' },
                            'failed': { text: 'Status: Failed', color: 'text-red-400' },
                            'expired': { text: 'Status: Expired', color: 'text-red-400' }
                        };
                        const statusInfo = statusMap[data.status] || { text: 'Status: ' + data.status, color: 'text-yellow-400' };
                        statusText.textContent = statusInfo.text;
                        statusText.className = statusInfo.color + ' font-medium';
                    }
                    
                    if (refreshBtn) {
                        refreshBtn.disabled = false;
                        refreshBtn.innerHTML = `
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="animate-spin">
                                <path d="M21.5 2v6h-6M2.5 22v-6h6M2 11.5a10 10 0 0 1 18.8-4.3M22 12.5a10 10 0 0 1-18.8 4.2"></path>
                            </svg>
                            Refresh Status
                        `;
                    }
                }
            } catch (error) {
                console.error('Payment status check error:', error);
                if (refreshBtn) {
                    refreshBtn.disabled = false;
                    refreshBtn.innerHTML = 'Refresh Status';
                }
            }
        };
        
        window.closePaymentModal = function() {
            if (window.paymentStatusInterval) {
                clearInterval(window.paymentStatusInterval);
            }
            
            const modal = document.getElementById('payment-modal');
            if (modal) {
                modal.style.opacity = '0';
                modal.style.transition = 'opacity 0.3s';
                setTimeout(() => {
                    modal.remove();
                }, 300);
            }
        };
        
        const urlParams = new URLSearchParams(window.location.search);
        if (urlParams.get('success') === 'true') {
            const amount = urlParams.get('amount');
            Swal.fire({
                title: 'Payment Successful!',
                text: amount ? `$${amount} will be added to your balance shortly.` : 'Your payment was successful!',
                icon: 'success',
                background: '#030014',
                color: '#e5e7eb',
                confirmButtonText: 'OK',
                confirmButtonColor: '#10b981'
            }).then(() => {
                window.location.href = '/add-balance';
            });
        } else if (urlParams.get('canceled') === 'true') {
            Swal.fire({
                title: 'Payment Canceled',
                text: 'Your payment was canceled. You can try again anytime.',
                icon: 'info',
                background: '#030014',
                color: '#e5e7eb',
                confirmButtonText: 'OK',
                confirmButtonColor: '#4f46e5'
            });
        }

        function copyToClipboard(text) {
            navigator.clipboard.writeText(text).then(() => {
                Swal.fire({
                    title: 'Copied!',
                    text: 'Username copied to clipboard',
                    icon: 'success',
                    background: '#030014',
                    color: '#e5e7eb',
                    timer: 2000,
                    showConfirmButton: false
                });
            }).catch(err => {
                console.error('Failed to copy:', err);
            });
        }

        const copyUsernameBtn = document.getElementById('copy-username-btn');
        if (copyUsernameBtn) {
            copyUsernameBtn.addEventListener('click', () => {
                const usernameText = document.getElementById('username-text');
                if (usernameText) {
                    copyToClipboard(usernameText.textContent.trim());
                }
            });
        }

        updatePaymentSummary();
        updateProceedButton();

         const userProfileBtn = document.getElementById('user-profile-btn');
        const userDropdown = document.getElementById('user-dropdown');
        const chevronIcon = document.getElementById('chevron-icon');

        if (userProfileBtn && userDropdown) {
            userProfileBtn.addEventListener('click', (e) => {
                e.stopPropagation();
                userDropdown.classList.toggle('show');
                chevronIcon.style.transform = userDropdown.classList.contains('show') ? 'rotate(180deg)' : 'rotate(0deg)';
            });

            document.addEventListener('click', (e) => {
                if (!userProfileBtn.contains(e.target) && !userDropdown.contains(e.target)) {
                    userDropdown.classList.remove('show');
                    chevronIcon.style.transform = 'rotate(0deg)';
                }
            });
        }

        function copyUserId(event) {
            const userIdElement = document.getElementById('user-id-text');
            const userId = userIdElement ? userIdElement.getAttribute('data-user-id') : null;
            
            if (!userId) {
                console.error('User ID not found');
                return;
            }
            
            navigator.clipboard.writeText(userId).then(() => {
                const btn = event.target;
                const originalIcon = btn.className;
                btn.className = 'fas fa-check copy-id-btn';
                btn.style.color = '#10b981';
                
                setTimeout(() => {
                    btn.className = originalIcon;
                    btn.style.color = '';
                }, 2000);
            }).catch(err => {
                console.error('Failed to copy:', err);
            });
        }

        async function handleLogout() {
            try {
                const response = await fetch(`${API_URL}/auth/logout`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                });

                localStorage.removeItem('token');
                localStorage.removeItem('user');

                document.cookie = 'token=; Max-Age=0; Path=/; SameSite=Lax';

                window.location.href = '/login';
            } catch (error) {
                console.error('Logout error:', error);
                localStorage.removeItem('token');
                localStorage.removeItem('user');
                document.cookie = 'token=; Max-Age=0; Path=/; SameSite=Lax';
                window.location.href = '/login';
            }
        }

    </script>
</body>
</html>

