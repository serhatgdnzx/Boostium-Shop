            </div>

            <div class="flex flex-col sm:flex-row justify-between items-center gap-4 p-5 sm:p-6 rounded-xl bg-gradient-to-br from-purple-500/10 to-fuchsia-500/5 border border-purple-500/20 mb-6 hover:shadow-md hover:shadow-purple-500/5 transition-all duration-300">
                <div>
                    <div class="text-white font-medium mb-1 flex items-center gap-2">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-dollar-sign w-4 h-4 text-purple-400">
                            <line x1="12" x2="12" y1="2" y2="22"></line>
                            <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
                        </svg>
                        Payment Summary
                    </div>
                    <div class="text-sm text-zinc-400">
                        <span class="flex items-center gap-1">
                            <span class="text-purple-400 font-medium" data-summary-amount>$0.00</span> will be added to your balance
                        </span>
                    </div>
                </div>
                <button type="submit" class="px-5 sm:px-6 py-3 rounded-lg text-white font-medium shadow-lg transition-all duration-200 flex items-center gap-2 w-full sm:w-auto justify-center bg-zinc-800 cursor-not-allowed opacity-50" disabled="">
                    Proceed to Payment
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right w-4 h-4">
                        <path d="M5 12h14"></path>
                        <path d="m12 5 7 7-7 7"></path>
