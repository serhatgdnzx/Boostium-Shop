            document.body.insertAdjacentHTML('beforeend', modalHTML);
            
            const iframe = document.getElementById('payment-iframe');
            
            const messageHandler = function(event) {
                if (event.origin.includes('sell.app') || event.origin.includes('boostium.sell.app')) {
                    if (event.data && (event.data.type === 'payment_success' || event.data.type === 'order_completed' || event.data.success)) {
                        window.removeEventListener('message', messageHandler);
                        closePaymentModal();
                        
                        Swal.fire({
