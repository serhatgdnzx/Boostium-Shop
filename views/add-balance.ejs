<!DOCTYPE html>
<html lang="tr" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof title !== 'undefined' ? title : `Add Balance | ${typeof siteName !== 'undefined' ? siteName : 'Boostium.shop'}` %></title>
    <meta name="description" content="<%= typeof siteDescription !== 'undefined' ? siteDescription : 'Boostium.shop is a platform for boosting servers.' %>">
    <meta name="keywords" content="<%= typeof siteKeywords !== 'undefined' ? siteKeywords : 'boosts, servers, boosting, platform' %>">
    <meta property="og:title" content="<%= typeof siteName !== 'undefined' ? siteName : 'Boostium.shop' %>">
    <meta property="og:description" content="<%= typeof siteDescription !== 'undefined' ? siteDescription : 'Boostium.shop is a platform for boosting servers.' %>">
    <meta property="og:url" content="<%= typeof siteUrl !== 'undefined' ? siteUrl : 'https://boostium.shop' %>">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Plus Jakarta Sans', 'sans-serif'],
                    },
                    colors: {
                        void: '#030014',
                        glass: 'rgba(255, 255, 255, 0.03)',
                        glassBorder: 'rgba(255, 255, 255, 0.08)',
                        neon: {
                            pink: '#F472B6',
                            blue: '#60A5FA',
                            purple: '#A78BFA'
                        }
                    },
                    backgroundImage: {
                        'nebula': 'radial-gradient(circle at 50% -20%, #2e1065, #030014 60%)',
                        'card-gradient': 'linear-gradient(180deg, rgba(255,255,255,0.05) 0%, rgba(255,255,255,0) 100%)'
                    },
                    animation: {
                        'blob': 'blob 10s infinite',
                        'float': 'float 6s ease-in-out infinite',
                    },
                    keyframes: {
                        blob: {
                            '0%': { transform: 'translate(0px, 0px) scale(1)' },
                            '33%': { transform: 'translate(30px, -50px) scale(1.1)' },
                            '66%': { transform: 'translate(-20px, 20px) scale(0.9)' },
                            '100%': { transform: 'translate(0px, 0px) scale(1)' }
                        },
                        float: {
                            '0%, 100%': { transform: 'translateY(0)' },
                            '50%': { transform: 'translateY(-20px)' }
                        }
                    }
                }
            }
        }
    </script>
    <style>
        body {
            background-color: #030014;
            color: #ffffff;
            overflow-x: hidden;
        }

        .spotlight-card {
            position: relative;
            overflow: hidden;
            background: rgba(255, 255, 255, 0.01);
            border: 1px solid rgba(255, 255, 255, 0.05);
            transition: border-color 0.3s;
        }

        .spotlight-card::before {
            content: "";
            position: absolute;
            background: radial-gradient(
                800px circle at var(--mouse-x) var(--mouse-y),
                rgba(255, 255, 255, 0.06),
                transparent 40%
            );
            z-index: 3;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            opacity: 0;
            transition: opacity 0.5s;
            pointer-events: none;
        }

        .spotlight-card:hover::before {
            opacity: 1;
        }

        .spotlight-card:hover {
            border-color: rgba(255, 255, 255, 0.2);
        }

        .ambient-glow {
            position: absolute;
            width: 600px;
            height: 600px;
            background: linear-gradient(180deg, rgba(167, 139, 250, 0.3) 0%, rgba(244, 114, 182, 0.1) 100%);
            filter: blur(100px);
            border-radius: 50%;
            z-index: -1;
            opacity: 0.6;
        }
        
        .text-gradient {
            background: linear-gradient(to right, #c084fc, #60a5fa);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .nav-link {
            transition: all 0.3s;
        }

        .nav-link:hover {
            color: #a78bfa;
        }

        .nav-link.active {
            color: #a78bfa;
        }

        @keyframes shimmer {
            100% { transform: translateX(100%); }
        }

        .package-card {
            cursor: pointer;
            transition: all 0.3s;
        }

        .package-card:hover:not(.disabled) {
            transform: scale(1.02);
            border-color: rgba(255, 255, 255, 0.3);
        }

        .package-card.disabled {
            cursor: not-allowed;
            opacity: 0.6;
            pointer-events: none;
        }

        .package-card.selected {
            border-color: rgba(99, 102, 241, 0.5);
            box-shadow: 0 0 20px rgba(99, 102, 241, 0.3);
        }

        .out-of-stock-banner {
            position: absolute;
            top: 0;
            right: 0;
            width: 100%;
            height: 100%;
            overflow: hidden;
            z-index: 20;
            pointer-events: none;
        }
        
        .out-of-stock-banner::before {
            content: '';
            position: absolute;
            top: 0;
            right: 0;
            width: 150px;
            height: 40px;
            background: #dc2626;
            transform: rotate(45deg);
            transform-origin: top right;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.4);
            margin-top: 15px;
            margin-right: -35px;
        }
        
        .out-of-stock-banner::after {
            content: 'OUT OF STOCK';
            position: absolute;
            top: 22px;
            right: 8px;
            color: white;
            font-weight: bold;
            font-size: 10px;
            letter-spacing: 1.5px;
            transform: rotate(45deg);
            transform-origin: center;
            text-transform: uppercase;
            text-shadow: 0 1px 3px rgba(0, 0, 0, 0.5);
            white-space: nowrap;
            z-index: 21;
        }

        .user-profile-card {
            position: relative;
            transition: all 0.3s ease;
            cursor: pointer;
        }

        .user-profile-card:hover {
            border-color: rgba(167, 139, 250, 0.5) !important;
        }

        .user-profile-card:hover #user-profile-btn {
            box-shadow: 
                0 0 15px rgba(167, 139, 250, 0.6),
                0 0 30px rgba(167, 139, 250, 0.4),
                0 0 45px rgba(244, 114, 182, 0.3),
                0 0 60px rgba(244, 114, 182, 0.2);
        }

        .user-dropdown {
            position: absolute;
            top: calc(100% + 12px);
            right: 0;
            background: rgba(15, 10, 30, 0.95);
            backdrop-filter: blur(20px);
            border: 1px solid rgba(167, 139, 250, 0.2);
            border-radius: 16px;
            width: 280px;
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.6), 0 0 20px rgba(167, 139, 250, 0.15);
            opacity: 0;
            visibility: hidden;
            transform: translateY(-10px);
            transition: all 0.3s ease;
            z-index: 1000;
            overflow: hidden;
        }

        .user-dropdown.show {
            opacity: 1;
            visibility: visible;
            transform: translateY(0);
        }

        .user-dropdown-header {
            padding: 16px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        }

        .user-status-row {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 12px;
        }

        .status-badge {
            background: linear-gradient(135deg, #a78bfa 0%, #c084fc 100%);
            color: white;
            padding: 5px 14px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            display: inline-block;
            min-width: 40px;
            text-align: center;
        }

        .user-info-row {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 12px;
        }

        .user-name {
            color: white;
            font-size: 14px;
            font-weight: 600;
        }

        .user-id {
            color: rgba(255, 255, 255, 0.6);
            font-size: 12px;
            font-family: 'Courier New', monospace;
        }

        .copy-id-btn {
            color: rgba(255, 255, 255, 0.5);
            cursor: pointer;
            transition: color 0.2s;
            font-size: 12px;
        }

        .copy-id-btn:hover {
            color: rgba(255, 255, 255, 0.8);
        }

        .balance-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            background: rgba(167, 139, 250, 0.1);
            border: 1px solid rgba(167, 139, 250, 0.2);
            border-radius: 10px;
            padding: 10px 12px;
        }

        .balance-label {
            display: flex;
            align-items: center;
            gap: 8px;
            color: rgba(255, 255, 255, 0.8);
            font-size: 13px;
            font-weight: 500;
        }

        .balance-value {
            color: white;
            font-size: 14px;
            font-weight: 700;
        }

        .user-dropdown-menu {
            padding: 8px;
        }

        .user-dropdown-item {
            padding: 12px 14px;
            color: rgba(255, 255, 255, 0.9);
            font-size: 14px;
            font-weight: 500;
            transition: all 0.2s ease;
            display: flex;
            align-items: center;
            gap: 12px;
            border-radius: 10px;
            cursor: pointer;
            margin-bottom: 4px;
        }

        .user-dropdown-item:last-child {
            margin-bottom: 0;
        }

        .user-dropdown-item:hover {
            background: rgba(167, 139, 250, 0.15);
            color: #a78bfa;
        }

        .user-dropdown-item.logout:hover {
            background: rgba(244, 114, 182, 0.15);
            color: #f472b6;
        }

        .user-dropdown-item i {
            width: 18px;
            text-align: center;
            font-size: 14px;
        }

        .advertisement-banner {
            max-height: 200px;
            width: 100%;
            object-fit: cover;
            transition: transform 0.3s ease;
        }

        .advertisement-banner:hover {
            transform: scale(1.02);
        }

        .advertisement-link {
            display: block;
            text-decoration: none;
        }

        .advertisement-link:hover {
            text-decoration: none;
        }

        .leaderboard-rank-badge {
            width: 28px;
            height: 28px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: 12px;
            flex-shrink: 0;
        }

        .leaderboard-rank-badge.rank-1 {
            background: linear-gradient(135deg, #fbbf24 0%, #f59e0b 100%);
            color: white;
        }

        .leaderboard-rank-badge.rank-2 {
            background: linear-gradient(135deg, #e5e7eb 0%, #9ca3af 100%);
            color: #1f2937;
        }

        .leaderboard-rank-badge.rank-3 {
            background: linear-gradient(135deg, #d97706 0%, #92400e 100%);
            color: white;
        }

        .leaderboard-rank-badge.rank-other {
            background: rgba(255, 255, 255, 0.05);
            color: rgba(255, 255, 255, 0.6);
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        .leaderboard-row {
            transition: background-color 0.2s;
        }

        .leaderboard-row:hover {
            background-color: rgba(255, 255, 255, 0.05);
        }

        .rank-badge-prestige {
            background: rgba(31, 41, 55, 0.8);
            border: 1px solid rgba(255, 255, 255, 0.1);
            color: #fbbf24;
        }

        .rank-badge-gold {
            background: rgba(31, 41, 55, 0.8);
            border: 1px solid rgba(255, 255, 255, 0.1);
            color: #fbbf24;
        }
    </style>
</head>
<body class="selection:bg-indigo-500 selection:text-white min-h-screen">

    <!-- Background Elements -->
    <div class="fixed top-0 left-0 w-full h-full bg-nebula -z-20"></div>

     <!-- Navigation -->
     <div class="fixed w-full z-50 top-4 flex justify-center px-4">
        <nav class="bg-white/5 backdrop-blur-xl border border-white/10 rounded-full px-8 py-4 flex items-center justify-between gap-6 shadow-2xl shadow-indigo-500/10 w-full max-w-6xl">
            <!-- Left: Logo + Links -->
            <div class="flex items-center gap-10">
                <a href="/" class="font-bold text-xl tracking-tight flex items-center gap-2">
                    <span class="w-3 h-3 rounded-full bg-gradient-to-r from-pink-500 to-indigo-500"></span>
                    Boostium
                </a>
                <div class="hidden md:flex gap-8 text-sm font-medium text-gray-300">
                   
                </div>
            </div>

            <!-- Right: User Profile Summary -->
            <div class="hidden sm:flex items-center">
                <div class="user-profile-card relative">
                    <div id="user-profile-btn" class="flex items-center gap-2 bg-black/40 border border-white/10 rounded-2xl px-3 py-2 shadow-lg shadow-black/40">
                        <!-- Avatar with initials -->
                        <div class="w-7 h-7 rounded-lg bg-gradient-to-br from-purple-500 to-pink-500 flex items-center justify-center text-[10px] font-bold">
                            <%
                                let initials = 'US';
                                if (typeof userStats !== 'undefined' && userStats) {
                                    if (userStats.name && userStats.name.trim().length > 0) {
                                        const parts = userStats.name.trim().split(' ');
                                        initials = (parts[0][0] || '') + (parts[1] ? parts[1][0] : '');
                                        initials = initials.toUpperCase();
                                    } else if (userStats.email) {
                                        initials = userStats.email[0].toUpperCase();
                                    }
                                }
                            %>
                            <span><%= initials %></span>
                        </div>
                        <!-- Name + Balance -->
                        <div class="flex flex-col leading-tight">
                            <span class="text-[12px] font-semibold text-gray-100 max-w-[100px] truncate">
                                <%= (typeof userStats !== 'undefined' && userStats && userStats.name) ? userStats.name : 'Guest' %>
                            </span>
                            <a href="/add-balance" class="text-[11px] font-semibold text-purple-300 hover:text-purple-200 transition-colors cursor-pointer">
                                <% if (typeof userStats !== 'undefined' && userStats && typeof userStats.UserBalance === 'number') { %>
                                    $<%= userStats.UserBalance.toFixed(2) %>
                                <% } else { %>
                                    $0.00
                                <% } %>
                            </a>
                        </div>
                        <i class="fas fa-chevron-down text-[9px] text-gray-400 transition-transform duration-200" id="chevron-icon"></i>
                    </div>
                    
                    <!-- Dropdown Menu -->
                    <div id="user-dropdown" class="user-dropdown">
                        <!-- Header Section -->
                        <div class="user-dropdown-header">
                            <!-- Status + User Info -->
                            <div class="user-status-row">
                                <span class="status-badge">
                                    <%
                                        let badgeInitials = 'US';
                                        if (typeof userStats !== 'undefined' && userStats) {
                                            if (userStats.name && userStats.name.trim().length > 0) {
                                                const nameParts = userStats.name.trim().split(' ');
                                                if (nameParts.length > 1) {
                                                    badgeInitials = (nameParts[0][0] || '') + (nameParts[1][0] || '');
                                                } else {
                                                    badgeInitials = nameParts[0].substring(0, 2);
                                                    if (badgeInitials.length < 2) {
                                                        badgeInitials = badgeInitials + badgeInitials;
                                                    }
                                                }
                                                badgeInitials = badgeInitials.toUpperCase();
                                            } else if (userStats.email) {
                                                badgeInitials = userStats.email.substring(0, 2).toUpperCase();
                                            }
                                        }
                                    %>
                                    <%= badgeInitials %>
                                </span>
                                <div class="user-info-row">
                                    <span class="user-name">
                                        <%= (typeof userStats !== 'undefined' && userStats && userStats.name) ? userStats.name : 'Guest' %>
                                    </span>
                                </div>
                            </div>
                            <!-- User ID -->
                            <div class="user-info-row" style="margin-bottom: 12px;">
                                <span class="user-id" id="user-id-text" data-user-id="<%= (typeof userStats !== 'undefined' && userStats && userStats._id) ? userStats._id.toString() : '' %>">
                                    <% if (typeof userStats !== 'undefined' && userStats && userStats._id) { %>
                                        <%= userStats._id.toString().substring(0, 10) %>...
                                    <% } else { %>
                                        N/A
                                    <% } %>
                                </span>
                                <i class="fas fa-clipboard copy-id-btn" onclick="copyUserId(event)" title="Copy User ID"></i>
                            </div>
                            <!-- Balance -->
                            <div class="balance-row">
                                <div class="balance-label">
                                    <i class="fas fa-wallet"></i>
                                    <span>Balance:</span>
                                </div>
                                <a href="/add-balance" class="balance-value hover:text-purple-300 transition-colors cursor-pointer">
                                    <% if (typeof userStats !== 'undefined' && userStats && typeof userStats.UserBalance === 'number') { %>
                                        $<%= userStats.UserBalance.toFixed(2) %>
                                    <% } else { %>
                                        $0.00
                                    <% } %>
                                </a>
                            </div>
                        </div>
                        <!-- Menu Items -->
                        <div class="user-dropdown-menu">
                            <div class="user-dropdown-item" onclick="window.location.href='/account-settings'">
                                <i class="fas fa-cog"></i>
                                <span>Account Settings</span>
                            </div>
                            <div class="user-dropdown-item" onclick="window.location.href='/order-history'">
                                <i class="fas fa-history"></i>
                                <span>Order History</span>
                            </div>
                            <div class="user-dropdown-item logout" onclick="handleLogout()">
                                <i class="fas fa-sign-out-alt"></i>
                                <span>Logout</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </nav>
    </div>

    <!-- Main Content -->
    <div class="max-w-4xl mx-auto px-6 pt-32 pb-10">
        <!-- Header -->
        <div class="mb-8 text-center">
            <h1 class="text-4xl font-bold mb-2">Add Funds</h1>
            <p class="text-gray-400">Add funds to your account to purchase boosts</p>
        </div>

        <!-- Add Balance Card -->
        <div class="spotlight-card rounded-2xl p-6">
            <div class="flex items-center gap-2 mb-6">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-wallet w-5 h-5 text-purple-400"><path d="M19 7V4a1 1 0 0 0-1-1H5a2 2 0 0 0 0 4h15a1 1 0 0 1 1 1v4h-3a2 2 0 0 0 0 4h3a1 1 0 0 0 1-1v-2a1 1 0 0 0-1-1"></path><path d="M3 5v14a2 2 0 0 0 2 2h15a1 1 0 0 0 1-1v-4"></path></svg>
                <h2 class="text-xl font-bold">Add Funds</h2>
            </div>

            <div class="mb-6">
                <label for="amount" class="block text-sm font-medium text-zinc-400 mb-2 flex items-center gap-1.5">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-dollar-sign w-4 h-4 text-purple-400">
                        <line x1="12" x2="12" y1="2" y2="22"></line>
                        <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
                    </svg>
                    Amount (USD)
                </label>
                <div class="relative group">
                    <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-dollar-sign h-5 w-5 text-zinc-500 group-focus-within:text-purple-400 transition-colors duration-200">
                            <line x1="12" x2="12" y1="2" y2="22"></line>
                            <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
                        </svg>
                    </div>
                    <input id="amount" placeholder="Enter amount (min $20)" min="20" step="0.01" class="w-full bg-zinc-800/50 border border-zinc-700/50 focus:border-purple-500/50 rounded-lg pl-12 pr-4 py-3 text-white placeholder-zinc-500 focus:outline-none focus:ring-2 focus:ring-purple-500/20 transition-all duration-200" type="number" data-gtm-form-interact-field-id="0">
                </div>
                <div class="mt-4 grid grid-cols-3 sm:grid-cols-6 gap-2">
                    <button type="button" data-preset-amount="20" class="px-3 py-2 rounded-lg text-sm font-medium border bg-zinc-800/50 border-zinc-700/50 text-zinc-400 hover:text-white hover:bg-zinc-800 hover:border-purple-500/20 transition-all duration-200 transform hover:scale-[1.02] active:scale-[0.98]">$20</button>
                    <button type="button" data-preset-amount="25" class="px-3 py-2 rounded-lg text-sm font-medium border bg-zinc-800/50 border-zinc-700/50 text-zinc-400 hover:text-white hover:bg-zinc-800 hover:border-purple-500/20 transition-all duration-200 transform hover:scale-[1.02] active:scale-[0.98]">$25</button>
                    <button type="button" data-preset-amount="50" class="px-3 py-2 rounded-lg text-sm font-medium border bg-zinc-800/50 border-zinc-700/50 text-zinc-400 hover:text-white hover:bg-zinc-800 hover:border-purple-500/20 transition-all duration-200 transform hover:scale-[1.02] active:scale-[0.98]">$50</button>
                    <button type="button" data-preset-amount="100" class="px-3 py-2 rounded-lg text-sm font-medium border bg-zinc-800/50 border-zinc-700/50 text-zinc-400 hover:text-white hover:bg-zinc-800 hover:border-purple-500/20 transition-all duration-200 transform hover:scale-[1.02] active:scale-[0.98]">$100</button>
                    <button type="button" data-preset-amount="250" class="px-3 py-2 rounded-lg text-sm font-medium border bg-zinc-800/50 border-zinc-700/50 text-zinc-400 hover:text-white hover:bg-zinc-800 hover:border-purple-500/20 transition-all duration-200 transform hover:scale-[1.02] active:scale-[0.98]">$250</button>
                    <button type="button" data-preset-amount="500" class="px-3 py-2 rounded-lg text-sm font-medium border bg-zinc-800/50 border-zinc-700/50 text-zinc-400 hover:text-white hover:bg-zinc-800 hover:border-purple-500/20 transition-all duration-200 transform hover:scale-[1.02] active:scale-[0.98]">$500</button>
                </div>
                <p class="mt-2 text-xs text-zinc-500">Minimum tutar: $20</p>
            </div>


            <div class="mb-8">
                <label class="block text-sm font-medium text-zinc-400 mb-2 flex items-center gap-1.5">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-coins w-4 h-4 text-purple-400">
                        <circle cx="8" cy="8" r="6"></circle>
                        <path d="M18.09 10.37A6 6 0 1 1 10.34 18"></path>
                        <path d="M7 6h1v4"></path>
                        <path d="M16 6h1v4"></path>
                    </svg>
                    Select Cryptocurrency
                </label>
                <div class="border-t border-white/10 mb-3"></div>
                
                <!-- Currency Dropdown -->
                <div class="relative" id="currency-dropdown-container">
                    <!-- Selected Currency Button -->
