                                <img src="https://assets.coingecko.com/coins/images/1094/large/tron-logo.png" alt="TRX" class="w-8 h-8 rounded-full">
                            </div>
                            <div class="flex-1 text-left">
                                <div class="font-medium text-white">TRON</div>
                                <div class="text-xs text-gray-400">TRX</div>
                            </div>
                            <div class="px-2 py-1 bg-orange-500/20 border border-orange-500/30 rounded text-xs font-semibold text-orange-300">
                                TRX
                            </div>
                            <div class="text-orange-400 hidden currency-check">
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
