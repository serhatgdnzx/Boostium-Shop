<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> | Boostium</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }
    </style>
</head>
<body>
    <div class="text-center px-6 py-12 bg-white/10 backdrop-blur-lg rounded-2xl shadow-2xl max-w-2xl mx-4">
        <div class="mb-8">
            <i class="fas fa-tools text-6xl text-white mb-4"></i>
        </div>
        <h1 class="text-4xl font-bold text-white mb-4">Maintenance Mode</h1>
        <p class="text-xl text-white/90 mb-8"><%= message %></p>
        <div class="flex items-center justify-center gap-2 text-white/70">
            <i class="fas fa-clock"></i>
            <span>We'll be back soon!</span>
        </div>
    </div>
</body>
</html>

